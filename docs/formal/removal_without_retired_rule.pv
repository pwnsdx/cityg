(* Sanity check: without retired admissions (section 7), the removed member
   joins again with the admission it kept and learns the secret of the next
   epoch. Expected result: false.
   Run: proverif -lib cityg.pvl removal_without_retired_rule.pv *)

query pk: spkey, gc: bitstring, es: key;
  event(Accepted(pk, N4, gc, es)) && attacker(es) ==> false.

process
  out(c, (spk(skA), spk(skB), spk(skD)));
  (RM_Setup | RM_A3 | RM_A4(false))
