(* Scenario AUTHORIZER_ENTRY_UNSIGNED_TAG: the entry of authorizer_entry.pv,
   with a checkpoint that signs the group context alone: J checks the tag
   the delivery service hands it. *)

free MJ: bitstring [private].
query attacker(MJ).

event AcceptedJ(key).
query es: key; event(AcceptedJ(es)).

process
  new skZ: skey; new skE: skey; new ikJ: key; new init1: key;
  out(c, (spk(skZ), skE, kempk(ikJ)));
  (
    new r2: key; new qw: key;
    let gc2 = (N2, node_pk(r2)) in
    let js2 = joiner_secret(init1, r2, gc2) in
    let es2 = epoch_secret(js2) in
    out(c, (gc2, tag(es2, gc2), wrap(kempk(ikJ), qw, js2), sign(skZ, (N2, hash(gc2)))))
  ) | (
    in(c, (gc: bitstring, tg: bitstring, wel: bitstring, cp: bitstring));
    if checksign(spk(skZ), (N2, hash(gc)), cp) = true then
    let es = epoch_secret(unwrap(ikJ, wel)) in
    if tag(es, gc) = tg then
    event AcceptedJ(es);
    out(c, aenc(msg_key(es), MJ))
  )
