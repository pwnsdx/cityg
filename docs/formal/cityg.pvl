(* City-G profile v0.3: symbolic model, shared definitions and scenarios.

   Primitives are ideal (Dolev-Yao): X-Wing is an IND-CCA2 KEM,
   ChaCha20-Poly1305 an ideal AEAD, ML-DSA-65 an unforgeable signature bound
   to its FIPS 204 context string, BLAKE3 and its keyed modes one-way
   functions. Section numbers refer to docs/specs.md; README.md lists the
   abstractions.

   A tree is a tuple of leaf nodes and parent nodes (section 6.2):
     leaf node   (device key, since, leaf key, admission hash), or NONE
     parent node (key, unmerged leaves), or NONE
   and its hash is the hash of the tuple (section 6.3 binds the same values
   through a Merkle tree). A registry is (admin leaves, retired admission)
   (section 7). Node indices follow the RFC 9420 array layout (section 6.1):
   leaf i is node 2i, and with 4 leaves node 1 is the parent of leaves 0
   and 1, node 5 the parent of leaves 2 and 3, node 3 the root. *)

type key.      (* 32-byte secrets, seeds, nonces *)
type skey.     (* ML-DSA-65 device key *)
type spkey.    (* its public key *)
type kpk.      (* X-Wing encapsulation key *)

free c: channel.

const ZERO: key.
const NONE: bitstring.
(* Admission hash of the creator (ZERO32). *)
const NOADM: bitstring.

(* Epochs, leaves and nodes. *)
const N0, N1, N2, N3, N4, N5, N6: bitstring.

(* Derivation labels (section 17.2) *)
const L_tree_path, L_node_key, L_leaf_key, L_joiner, L_epoch, L_init, L_msg,
      L_confirm, L_external, L_ext_kem, L_ext_init, L_wrap_key,
      L_wrap_nonce, L_welcome_key, L_welcome_nonce, L_msg_sender, L_msg_key,
      L_msg_nonce: bitstring.

(* Commit kinds (section 9.3) *)
const K_genesis, K_member, K_join, K_resync: bitstring.

(* Signature contexts (section 17.3) *)
const CTX_ANCHOR, CTX_ROTATION, CTX_GROUP_INFO, CTX_ADMISSION, CTX_JOIN,
      CTX_REMOVE, CTX_MSG: bitstring.

(* ---------- BLAKE3: H, Extract, ExpandLabel, MAC (section 4) ---------- *)

fun hash(bitstring): bitstring.
fun extract(key, key): key.
fun expand_label(key, bitstring, bitstring): key.
fun mac(key, bitstring): bitstring.

letfun derive(s: key, l: bitstring) = expand_label(s, l, NONE).

(* ---------- X-Wing ---------- *)

fun kempk(key): kpk.
fun kemct(kpk, key): bitstring.     (* encapsulation with randomness r *)
fun kemss(kpk, key): key.
reduc forall s: key, r: key; decaps(s, kemct(kempk(s), r)) = kemss(kempk(s), r).

(* ---------- ChaCha20-Poly1305 ---------- *)

fun wrapk(key, key, bitstring, key): bitstring.
reduc forall k: key, n: key, ad: bitstring, m: key;
  unwrapk(k, n, ad, wrapk(k, n, ad, m)) = m.

fun aenc(key, key, bitstring, bitstring): bitstring.
reduc forall k: key, n: key, ad: bitstring, m: bitstring;
  adec(k, n, ad, aenc(k, n, ad, m)) = m.

(* ---------- ML-DSA-65 with contexts ---------- *)

fun spk(skey): spkey.
fun sign(skey, bitstring, bitstring): bitstring.
reduc forall sk: skey, ctx: bitstring, m: bitstring;
  verify(spk(sk), ctx, m, sign(sk, ctx, m)) = true.

(* ---------- Protocol functions ---------- *)

(* Identifiers (section 5) *)
letfun device_id(gid: bitstring, pk: spkey) = hash((gid, pk)).

(* Leaf and node keys (section 6.5). Members keep KEM seeds, never the leaf
   secret they drew. *)
letfun leaf_sk(ls: key) = expand_label(ls, L_leaf_key, NONE).
letfun leaf_pk(ls: key) = kempk(leaf_sk(ls)).
letfun path_secret(s: key) = derive(s, L_tree_path).
letfun node_sk(ps: key) = expand_label(ps, L_node_key, NONE).
letfun node_pk(ps: key) = kempk(node_sk(ps)).

(* Wrap of a path secret to a target key (section 6.5). *)
letfun wrap_ctx(gid: bitstring, epoch: bitstring, author: bitstring,
                node: bitstring, target: bitstring, pk: kpk) =
  (gid, epoch, author, node, target, pk).
letfun wrap_key(ss: key, ctx: bitstring) = expand_label(ss, L_wrap_key, ctx).
letfun wrap_nonce(ss: key, ctx: bitstring) = expand_label(ss, L_wrap_nonce, ctx).

(* Key schedule (section 8): the commit secret goes through the joiner
   secret, which welcomes carry. *)
letfun joiner_secret(init_prev: key, cs: key, gc: bitstring) =
  expand_label(extract(init_prev, cs), L_joiner, hash(gc)).
letfun epoch_secret(js: key) = derive(js, L_epoch).
letfun init_secret(es: key) = derive(es, L_init).
letfun confirm_key(es: key) = derive(es, L_confirm).
letfun msg_secret(es: key) = derive(es, L_msg).
letfun external_secret(es: key) = derive(es, L_external).
letfun external_sk(es: key) = expand_label(external_secret(es), L_ext_kem, NONE).
letfun external_init(ss: key, ct: bitstring) =
  expand_label(extract(ZERO, ss), L_ext_init, hash(ct)).

(* Welcome (section 10.3): the joiner secret, sealed to the request's
   one-time init key. *)
letfun welcome_ctx(gid: bitstring, epoch: bitstring, ref: bitstring, pk: kpk) =
  (gid, epoch, ref, pk).
letfun welcome_key(ss: key, ctx: bitstring) = expand_label(ss, L_welcome_key, ctx).
letfun welcome_nonce(ss: key, ctx: bitstring) = expand_label(ss, L_welcome_nonce, ctx).

(* Transcript (section 8). The specification hashes the previous interim
   hash, anchor_tbs, the signature and the rotation signature. A symbolic
   signature contains the signed message, and anchor_tbs contains the
   previous interim hash, so hashing the signatures alone binds the same
   values with smaller terms. *)
letfun confirmed_th(sig: bitstring, rot: bitstring) = hash((sig, rot)).
letfun interim_th(cth: bitstring, tag: bitstring) = hash((cth, tag)).

(* Message plane (section 11.2): first key of the chain of the occupancy
   [leaf, since]. *)
letfun msg_key(es: key, sender: bitstring) =
  expand_label(expand_label(msg_secret(es), L_msg_sender, sender), L_msg_key, NONE).
letfun msg_nonce(es: key, sender: bitstring) =
  expand_label(expand_label(msg_secret(es), L_msg_sender, sender), L_msg_nonce, NONE).

(* ---------- Events ---------- *)

(* An honest member authored the commit creating epoch n with context gc
   (under the device key it holds after the commit). *)
event Committed(spkey, bitstring, bitstring).
(* An honest member accepted epoch n with context gc and epoch secret es. *)
event Accepted(spkey, bitstring, bitstring, key).
(* An honest member accepted the commit of epoch n with context gc, signed
   by the author key k. *)
event AcceptedCommit(spkey, bitstring, spkey, bitstring).
(* An admin signed an admission for a device key in a group. *)
event Admitted(spkey, bitstring, spkey).
(* An honest member accepted the entry of a device in epoch n. *)
event AcceptedJoin(spkey, bitstring, spkey).
(* The secret of an epoch before a join. *)
event PreviousEpoch(key).
(* Messages *)
event Sent(spkey, bitstring, bitstring).
event Received(spkey, spkey, bitstring, bitstring).

(* Device keys of the honest members. *)
free skA, skB, skB2, skD, skJ1, skJ2: skey [private].

(* ============ Scenario KS: a group grows from genesis ============

   Epoch 0: A creates the group (genesis, section 9.3): one leaf, width 1.
   Epoch 1: B enters with an ExternalJoin commit and an admission of A; the
            tree doubles to width 2 (leaf 0 A, leaf 1 B, root node 1).
   Epoch 2: B re-keys from a fresh leaf secret (self-update).

   Each member is a chain of processes, one per epoch, handing its state
   over on a private channel. leakA2 carries what A holds after epoch 2,
   leakB1 what B holds after epoch 1; a scenario decides whether the
   adversary learns it. *)

free stA0, stA1, stB1, leakA2, leakB1: channel [private].

let KS_A0 =
  let pkA = spk(skA) in
  new nonce: bitstring;
  let gid = hash((pkA, nonce)) in
  new lsA: key;
  (* Width 1: no parent node, the commit secret is path_secret[0]. *)
  let leafA = (pkA, N0, leaf_pk(lsA), NOADM) in
  let tree0 = leafA in
  let th0 = hash(tree0) in
  let reg0 = (N0, NONE) in
  let rh0 = hash(reg0) in
  let tbs0 = (gid, N0, K_genesis, NONE, N0, th0, rh0, leaf_pk(lsA), nonce, pkA) in
  let sig0 = sign(skA, CTX_ANCHOR, tbs0) in
  let cth0 = confirmed_th(sig0, NONE) in
  let gc0 = (gid, N0, th0, rh0, cth0) in
  let es0 = epoch_secret(joiner_secret(ZERO, path_secret(lsA), gc0)) in
  let tag0 = mac(confirm_key(es0), cth0) in
  let gi0 = (gc0, tag0, kempk(external_sk(es0)), N0) in
  event Committed(pkA, N0, gc0);
  event Accepted(pkA, N0, gc0, es0);
  out(c, (tbs0, sig0, tag0, gi0, sign(skA, CTX_GROUP_INFO, gi0), tree0, reg0));
  (* A admits B's device (section 10.2, kind 0). *)
  event Admitted(pkA, gid, spk(skB));
  out(c, sign(skA, CTX_ADMISSION, (gid, device_id(gid, spk(skB)))));
  out(stA0, (gid, lsA, es0, interim_th(cth0, tag0))).

(* A processes the ExternalJoin of some device X (sections 8.1, 9.4). X
   enters leaf 1 of the doubled tree; its root path secret is wrapped to
   A's leaf. *)
let KS_A1 =
  let pkA = spk(skA) in
  in(stA0, (gid: bitstring, lsA: key, es0: key, int0: bitstring));
  in(c, (tbs1: bitstring, sig1: bitstring, tag1: bitstring));
  let (=gid, =N1, =K_join, =int0, =N1, th1: bitstring, rh1: bitstring,
       (leafX: kpk, rootX: kpk, ctw1: bitstring, w1: bitstring),
       ctx1: bitstring, adm1: bitstring, pkX: spkey) = tbs1 in
  if verify(pkX, CTX_ANCHOR, tbs1, sig1) = true then
  if pkX <> pkA then
  (* The admission must be signed by an admin, here A (section 10.2). *)
  if verify(pkA, CTX_ADMISSION, (gid, device_id(gid, pkX)), adm1) = true then
  let wc1 = wrap_ctx(gid, N1, N1, N1, N0, leaf_pk(lsA)) in
  let ss1 = decaps(leaf_sk(lsA), ctw1) in
  let ps1 = unwrapk(wrap_key(ss1, wc1), wrap_nonce(ss1, wc1), wc1, w1) in
  (* Derived node keys must match the announced ones (section 6.5). *)
  if rootX = node_pk(ps1) then
  let tree1 = ((pkA, N0, leaf_pk(lsA), NOADM), (pkX, N1, leafX, hash(adm1)),
               (rootX, NONE)) in
  if th1 = hash(tree1) then
  if rh1 = hash((N0, NONE)) then
  let ssx = decaps(external_sk(es0), ctx1) in
  let cth1 = confirmed_th(sig1, NONE) in
  let gc1 = (gid, N1, th1, rh1, cth1) in
  let es1 = epoch_secret(joiner_secret(external_init(ssx, ctx1), path_secret(ps1), gc1)) in
  if tag1 = mac(confirm_key(es1), cth1) then
  event AcceptedJoin(pkA, N1, pkX);
  event Accepted(pkA, N1, gc1, es1);
  out(stA1, (gid, lsA, pkX, hash(adm1), rh1, es1, interim_th(cth1, tag1))).

(* A processes X's re-key. Then what A still holds may leak: its leaf and
   root private keys and the secrets kept until the next epoch (section 8);
   earlier epoch secrets and init secrets are erased. *)
let KS_A2 =
  let pkA = spk(skA) in
  in(stA1, (gid: bitstring, lsA: key, pkX: spkey, admX: bitstring, rh1: bitstring,
            es1: key, int1: bitstring));
  in(c, (tbs2: bitstring, sig2: bitstring, tag2: bitstring));
  let (=gid, =N2, =K_member, =int1, =N1, th2: bitstring, =rh1,
       (leafX2: kpk, rootX2: kpk, ctw2: bitstring, w2: bitstring), =pkX) = tbs2 in
  if verify(pkX, CTX_ANCHOR, tbs2, sig2) = true then
  let wc2 = wrap_ctx(gid, N2, N1, N1, N0, leaf_pk(lsA)) in
  let ss2 = decaps(leaf_sk(lsA), ctw2) in
  let ps2 = unwrapk(wrap_key(ss2, wc2), wrap_nonce(ss2, wc2), wc2, w2) in
  if rootX2 = node_pk(ps2) then
  if th2 = hash(((pkA, N0, leaf_pk(lsA), NOADM), (pkX, N1, leafX2, admX),
                 (rootX2, NONE))) then
  let cth2 = confirmed_th(sig2, NONE) in
  let gc2 = (gid, N2, th2, rh1, cth2) in
  let es2 = epoch_secret(joiner_secret(init_secret(es1), path_secret(ps2), gc2)) in
  if tag2 = mac(confirm_key(es2), cth2) then
  event Accepted(pkA, N2, gc2, es2);
  out(leakA2, (leaf_sk(lsA), node_sk(ps2), init_secret(es2),
               external_secret(es2), msg_secret(es2))).

(* B enters from A's signed GroupInfo (section 10.4) with an external commit
   (section 8.1). B checks the GroupInfo under A's key, the key of the admin
   that admitted it: README.md explains why a joiner must know a signer.
   What B holds after epoch 1 may leak. *)
let KS_B1 =
  let pkA = spk(skA) in
  let pkB = spk(skB) in
  in(c, (gi0: bitstring, gisig0: bitstring, tree0: bitstring, reg0: bitstring,
         adm: bitstring));
  if verify(pkA, CTX_GROUP_INFO, gi0, gisig0) = true then
  let ((gid: bitstring, =N0, th0: bitstring, rh0: bitstring, cth0: bitstring),
       tag0: bitstring, extpk0: kpk, =N0) = gi0 in
  if th0 = hash(tree0) then
  if rh0 = hash(reg0) then
  let (=pkA, sinceA: bitstring, leafA: kpk, admA: bitstring) = tree0 in
  let int0 = interim_th(cth0, tag0) in
  (* The joiner stages its commit with the same transition rules as every
     verifier: its admission must come from an admin (section 9.4). *)
  if verify(pkA, CTX_ADMISSION, (gid, device_id(gid, pkB)), adm) = true then
  new rx: key;
  let ctx1 = kemct(extpk0, rx) in
  let init1 = external_init(kemss(extpk0, rx), ctx1) in
  new lsB1: key;
  let psB1 = path_secret(lsB1) in
  new r1: key;
  let wc1 = wrap_ctx(gid, N1, N1, N1, N0, leafA) in
  let ss1 = kemss(leafA, r1) in
  let tree1 = (tree0, (pkB, N1, leaf_pk(lsB1), hash(adm)), (node_pk(psB1), NONE)) in
  let th1 = hash(tree1) in
  let rh1 = rh0 in
  let tbs1 = (gid, N1, K_join, int0, N1, th1, rh1,
              (leaf_pk(lsB1), node_pk(psB1), kemct(leafA, r1),
               wrapk(wrap_key(ss1, wc1), wrap_nonce(ss1, wc1), wc1, psB1)),
              ctx1, adm, pkB) in
  let sig1 = sign(skB, CTX_ANCHOR, tbs1) in
  let cth1 = confirmed_th(sig1, NONE) in
  let gc1 = (gid, N1, th1, rh1, cth1) in
  let es1 = epoch_secret(joiner_secret(init1, path_secret(psB1), gc1)) in
  let tag1 = mac(confirm_key(es1), cth1) in
  event Committed(pkB, N1, gc1);
  event Accepted(pkB, N1, gc1, es1);
  out(c, (tbs1, sig1, tag1));
  out(leakB1, (leaf_sk(lsB1), node_sk(psB1), init_secret(es1),
               external_secret(es1), msg_secret(es1)));
  out(stB1, (gid, tree0, hash(adm), rh1, es1, interim_th(cth1, tag1))).

(* B re-keys from a fresh leaf secret (self-update, section 13.4); the new
   root path secret goes to A's leaf. *)
let KS_B2 =
  let pkA = spk(skA) in
  let pkB = spk(skB) in
  in(stB1, (gid: bitstring, tree0: bitstring, admB: bitstring, rh1: bitstring,
            es1: key, int1: bitstring));
  let (=pkA, sinceA: bitstring, leafA: kpk, admA: bitstring) = tree0 in
  new lsB2: key;
  let psB2 = path_secret(lsB2) in
  new r2: key;
  let wc2 = wrap_ctx(gid, N2, N1, N1, N0, leafA) in
  let ss2 = kemss(leafA, r2) in
  let th2 = hash((tree0, (pkB, N1, leaf_pk(lsB2), admB), (node_pk(psB2), NONE))) in
  let tbs2 = (gid, N2, K_member, int1, N1, th2, rh1,
              (leaf_pk(lsB2), node_pk(psB2), kemct(leafA, r2),
               wrapk(wrap_key(ss2, wc2), wrap_nonce(ss2, wc2), wc2, psB2)),
              pkB) in
  let sig2 = sign(skB, CTX_ANCHOR, tbs2) in
  let cth2 = confirmed_th(sig2, NONE) in
  let gc2 = (gid, N2, th2, rh1, cth2) in
  let es2 = epoch_secret(joiner_secret(init_secret(es1), path_secret(psB2), gc2)) in
  let tag2 = mac(confirm_key(es2), cth2) in
  event Committed(pkB, N2, gc2);
  event Accepted(pkB, N2, gc2, es2);
  out(c, (tbs2, sig2, tag2)).

let KS = KS_A0 | KS_A1 | KS_A2 | KS_B1 | KS_B2.

(* ============ Scenario JN: a batched join with welcomes ============

   The group is at epoch 1 with A (leaf 0, admin) and B (leaf 1), width 2,
   root node 1. Two devices, J1 and J2, record join requests with
   admissions A signed (section 10.3). Epoch 2: A commits a Member commit
   that places two requests (section 9.4): the tree doubles to width 4, the
   joiners take leaves 2 and 3 under the new, blank node 5, and A's update
   path re-keys node 1 (wrapped to B's leaf) and the new root node 3
   (wrapped to the resolution of node 5: the joiners' leaf keys). A seals
   one welcome per request with the joiner secret of epoch 2. B processes
   the commit; each joiner enters with its welcome.

   JN_J(sk, trusted, leak): with [trusted], the joiner checks the GroupInfo
   under the key of A, the admin that admitted it; otherwise under the key
   that the tree it received names at the signer leaf. With [leak], the
   joiner's whole state after entering leaks (a malicious joiner). *)

free stJA, stJB: channel [private].

let JN_Setup =
  let pkA = spk(skA) in
  let pkB = spk(skB) in
  new nonce: bitstring;
  let gid = hash((pkA, nonce)) in
  new lsA: key; new lsB: key;
  new p1: key;
  new es1: key;
  new int1: bitstring;
  new admB: bitstring;
  event PreviousEpoch(es1);
  let leafA = (pkA, N0, leaf_pk(lsA), NOADM) in
  let leafB = (pkB, N1, leaf_pk(lsB), admB) in
  out(c, (gid, (leafA, leafB, (node_pk(p1), NONE)), (N0, NONE), int1));
  (* A admits J1 and J2 (section 10.2, kind 0). *)
  event Admitted(pkA, gid, spk(skJ1));
  event Admitted(pkA, gid, spk(skJ2));
  out(c, (sign(skA, CTX_ADMISSION, (gid, device_id(gid, spk(skJ1)))),
          sign(skA, CTX_ADMISSION, (gid, device_id(gid, spk(skJ2))))));
  out(stJA, (gid, lsA, leafB, es1, int1));
  out(stJB, (gid, leafA, leafB, lsB, es1, int1)).

(* Checks of a join request against the membership of epoch 1 (sections
   10.3, 9.4): signed by the joining device, admitted by the admin A, and
   the device is not a member. *)
letfun check_request(gid: bitstring, rq: bitstring, s: bitstring) =
  let (=gid, pkX: spkey, lkX: kpk, ikX: kpk, admX: bitstring) = rq in
  if verify(pkX, CTX_JOIN, rq, s) = true
     && verify(spk(skA), CTX_ADMISSION, (gid, device_id(gid, pkX)), admX) = true
     && pkX <> spk(skA) && pkX <> spk(skB) then
    (pkX, lkX, ikX, hash(admX)).

let JN_A2 =
  let pkA = spk(skA) in
  in(stJA, (gid: bitstring, lsA: key, leafB: bitstring, es1: key, int1: bitstring));
  let (pkB: spkey, sinceB: bitstring, lkB: kpk, admB: bitstring) = leafB in
  in(c, (rq1: bitstring, s1: bitstring, rq2: bitstring, s2: bitstring));
  let (pkX1: spkey, lkX1: kpk, ikX1: kpk, hX1: bitstring) = check_request(gid, rq1, s1) in
  let (pkX2: spkey, lkX2: kpk, ikX2: kpk, hX2: bitstring) = check_request(gid, rq2, s2) in
  if pkX1 <> pkX2 then
  new lsA2: key;
  let q1 = path_secret(lsA2) in
  let q3 = path_secret(q1) in
  let js_in = extract(init_secret(es1), path_secret(q3)) in
  new r1: key; new r2: key; new r3: key;
  let wcB = wrap_ctx(gid, N2, N0, N1, N2, lkB) in
  let wc1 = wrap_ctx(gid, N2, N0, N3, N4, lkX1) in
  let wc2 = wrap_ctx(gid, N2, N0, N3, N6, lkX2) in
  let ssB = kemss(lkB, r1) in
  let ss1 = kemss(lkX1, r2) in
  let ss2 = kemss(lkX2, r3) in
  let path = (leaf_pk(lsA2), node_pk(q1), node_pk(q3),
              kemct(lkB, r1), wrapk(wrap_key(ssB, wcB), wrap_nonce(ssB, wcB), wcB, q1),
              kemct(lkX1, r2), wrapk(wrap_key(ss1, wc1), wrap_nonce(ss1, wc1), wc1, q3),
              kemct(lkX2, r3), wrapk(wrap_key(ss2, wc2), wrap_nonce(ss2, wc2), wc2, q3)) in
  let tree2 = ((pkA, N0, leaf_pk(lsA2), NOADM), leafB,
               (pkX1, N2, lkX1, hX1), (pkX2, N2, lkX2, hX2),
               (node_pk(q1), NONE), (node_pk(q3), NONE), NONE) in
  let th2 = hash(tree2) in
  let reg2 = (N0, NONE) in
  let rh2 = hash(reg2) in
  let tbs2 = (gid, N2, K_member, int1, N0, th2, rh2, (rq1, s1, rq2, s2), path, pkA) in
  let sig2 = sign(skA, CTX_ANCHOR, tbs2) in
  let cth2 = confirmed_th(sig2, NONE) in
  let gc2 = (gid, N2, th2, rh2, cth2) in
  let js2 = expand_label(js_in, L_joiner, hash(gc2)) in
  let es2 = epoch_secret(js2) in
  let tag2 = mac(confirm_key(es2), cth2) in
  let gi2 = (gc2, tag2, kempk(external_sk(es2)), N0) in
  (* One welcome per request, in order (section 10.3). *)
  let ref1 = hash((rq1, s1)) in
  let ref2 = hash((rq2, s2)) in
  let wx1 = welcome_ctx(gid, N2, ref1, ikX1) in
  let wx2 = welcome_ctx(gid, N2, ref2, ikX2) in
  new rw1: key; new rw2: key;
  let sw1 = kemss(ikX1, rw1) in
  let sw2 = kemss(ikX2, rw2) in
  let welcome1 = (gid, N2, ref1, kemct(ikX1, rw1),
                  wrapk(welcome_key(sw1, wx1), welcome_nonce(sw1, wx1), wx1, js2)) in
  let welcome2 = (gid, N2, ref2, kemct(ikX2, rw2),
                  wrapk(welcome_key(sw2, wx2), welcome_nonce(sw2, wx2), wx2, js2)) in
  event Committed(pkA, N2, gc2);
  event Accepted(pkA, N2, gc2, es2);
  out(c, (tbs2, sig2, tag2, gi2, sign(skA, CTX_GROUP_INFO, gi2), tree2, reg2,
          welcome1, welcome2)).

(* B processes A's commit: it checks both requests like A, and takes node
   1's path secret from its leaf (section 6.5). *)
let JN_B2 =
  let pkA = spk(skA) in
  let pkB = spk(skB) in
  in(stJB, (gid: bitstring, leafA: bitstring, leafB: bitstring, lsB: key, es1: key,
            int1: bitstring));
  in(c, (tbs2: bitstring, sig2: bitstring, tag2: bitstring));
  let (=gid, =N2, =K_member, =int1, =N0, th2: bitstring, rh2: bitstring,
       (rq1: bitstring, s1: bitstring, rq2: bitstring, s2: bitstring),
       (leafA2: kpk, n1: kpk, n3: kpk, ctB: bitstring, wB: bitstring,
        ct1: bitstring, w1: bitstring, ct2: bitstring, w2: bitstring),
       =pkA) = tbs2 in
  if verify(pkA, CTX_ANCHOR, tbs2, sig2) = true then
  let (pkX1: spkey, lkX1: kpk, ikX1: kpk, hX1: bitstring) = check_request(gid, rq1, s1) in
  let (pkX2: spkey, lkX2: kpk, ikX2: kpk, hX2: bitstring) = check_request(gid, rq2, s2) in
  if pkX1 <> pkX2 then
  let wcB = wrap_ctx(gid, N2, N0, N1, N2, leaf_pk(lsB)) in
  let ssB = decaps(leaf_sk(lsB), ctB) in
  let q1 = unwrapk(wrap_key(ssB, wcB), wrap_nonce(ssB, wcB), wcB, wB) in
  let q3 = path_secret(q1) in
  if n1 = node_pk(q1) && n3 = node_pk(q3) then
  let (=pkA, sinceA: bitstring, leafAk: kpk, admA: bitstring) = leafA in
  let tree2 = ((pkA, sinceA, leafA2, admA), leafB,
               (pkX1, N2, lkX1, hX1), (pkX2, N2, lkX2, hX2),
               (n1, NONE), (n3, NONE), NONE) in
  if th2 = hash(tree2) then
  if rh2 = hash((N0, NONE)) then
  let cth2 = confirmed_th(sig2, NONE) in
  let gc2 = (gid, N2, th2, rh2, cth2) in
  let es2 = epoch_secret(joiner_secret(init_secret(es1), path_secret(q3), gc2)) in
  if tag2 = mac(confirm_key(es2), cth2) then
  event AcceptedJoin(pkB, N2, pkX1);
  event AcceptedJoin(pkB, N2, pkX2);
  event Accepted(pkB, N2, gc2, es2).

(* A joiner records its request, then enters with its welcome
   (section 10.3): the commit must include its request unchanged and
   create the epoch of the GroupInfo; the welcome opens with its init key;
   the confirmation tag and the external key must match the epoch; its
   leaf holds its record; and the root path secret, wrapped to its leaf,
   must match the published root key. *)
let JN_J(sk: skey, trusted: bool, leak: bool) =
  let pkA = spk(skA) in
  let pkJ = spk(sk) in
  in(c, (gid: bitstring, adm: bitstring));
  if verify(pkA, CTX_ADMISSION, (gid, device_id(gid, pkJ)), adm) = true then
  new lsJ: key;
  new ik: key;
  let rq = (gid, pkJ, leaf_pk(lsJ), kempk(ik), adm) in
  let s = sign(sk, CTX_JOIN, rq) in
  out(c, (rq, s));
  in(c, (tbs2: bitstring, sig2: bitstring, tag2: bitstring, gi2: bitstring,
         gisig2: bitstring, tree2: bitstring, reg2: bitstring, welcome: bitstring));
  let (leaf0: bitstring, leaf1: bitstring, leaf2: bitstring, leaf3: bitstring,
       node1: bitstring, (n3: kpk, =NONE), node5: bitstring) = tree2 in
  let (signer: spkey, since0: bitstring, lk0: kpk, adm0: bitstring) = leaf0 in
  if (trusted = true && signer = pkA) || trusted = false then
  if verify(signer, CTX_GROUP_INFO, gi2, gisig2) = true then
  let ((=gid, =N2, th2: bitstring, rh2: bitstring, cth2: bitstring),
       =tag2, extpk2: kpk, =N0) = gi2 in
  if th2 = hash(tree2) && rh2 = hash(reg2) then
  let (=gid, =N2, =K_member, int1: bitstring, =N0, =th2, =rh2,
       (rq1: bitstring, s1: bitstring, rq2: bitstring, s2: bitstring),
       (leafA2: kpk, n1: kpk, =n3, ctB: bitstring, wB: bitstring,
        ct1: bitstring, w1: bitstring, ct2: bitstring, w2: bitstring),
       =signer) = tbs2 in
  if cth2 = confirmed_th(sig2, NONE) then
  let (ref: bitstring, myleaf: bitstring, node: bitstring, ctj: bitstring,
       wj: bitstring) =
    if rq1 = rq && s1 = s then (hash((rq, s)), leaf2, N4, ct1, w1)
    else if rq2 = rq && s2 = s then (hash((rq, s)), leaf3, N6, ct2, w2) in
  if myleaf = (pkJ, N2, leaf_pk(lsJ), hash(adm)) then
  let (=gid, =N2, =ref, kct: bitstring, wr: bitstring) = welcome in
  let wx = welcome_ctx(gid, N2, ref, kempk(ik)) in
  let sw = decaps(ik, kct) in
  let js2 = unwrapk(welcome_key(sw, wx), welcome_nonce(sw, wx), wx, wr) in
  let es2 = epoch_secret(js2) in
  if tag2 = mac(confirm_key(es2), cth2) then
  if extpk2 = kempk(external_sk(es2)) then
  let wc = wrap_ctx(gid, N2, N0, N3, node, leaf_pk(lsJ)) in
  let ss = decaps(leaf_sk(lsJ), ctj) in
  let q3 = unwrapk(wrap_key(ss, wc), wrap_nonce(ss, wc), wc, wj) in
  if n3 = node_pk(q3) then
  event Accepted(pkJ, N2, (gid, N2, th2, rh2, cth2), es2);
  if leak = true then
  out(c, (ik, leaf_sk(lsJ), node_sk(q3), js2, es2)).

(* ============ Scenario RM: removal of a malicious member ============

   The group is at epoch 2 with A (leaf 0, admin), B (leaf 1) and C (leaf
   2), a malicious member; leaf 3 is blank. The adversary holds C's device
   key, all the secrets C holds as a member of epoch 2 (its leaf key, the
   keys of its direct path, the epoch secret) and the admission A once
   signed for C. Nodes: 1 (A and B), 5 (C), root 3.
   Epoch 3: a commit removes C (section 9.4) and B processes it: A's Member
            commit, which blanks C's leaf and path, retires C's admission
            and halves the tree to width 2 (root node 1); or, without the
            rule that a removal never targets the commit's author, a Resync
            by C that includes its own removal and re-enters its leaf.
   Epoch 4: A processes an ExternalJoin: D, an honest device A admitted, or
            the adversary trying to bring C back with its old admission.
            The tree doubles again: the joiner takes leaf 2 under the new,
            blank node 5, and its root path secret goes to node 1.

   RM_B3(false) omits the author rule, RM_A4(false) the retired
   admissions: the sanity scenarios check that the model finds the
   corresponding attacks. *)

free skC: skey.    (* the malicious member's device key: public *)
free stRA, stRB, stRA3: channel [private].

let RM_Setup =
  let pkA = spk(skA) in
  let pkB = spk(skB) in
  let pkC = spk(skC) in
  new nonce: bitstring;
  let gid = hash((pkA, nonce)) in
  new lsA: key; new lsB: key; new lsC: key;
  new p1: key; new p5: key; new p3: key;
  new es2: key;
  new int2: bitstring;
  new admB: bitstring;
  new sinceC: bitstring;
  (* The admission A once signed for C. *)
  let admC = sign(skA, CTX_ADMISSION, (gid, device_id(gid, pkC))) in
  event Admitted(pkA, gid, pkC);
  let leafA = (pkA, N0, leaf_pk(lsA), NOADM) in
  let leafB = (pkB, N1, leaf_pk(lsB), admB) in
  let leafC = (pkC, sinceC, leaf_pk(lsC), hash(admC)) in
  let tree2 = (leafA, leafB, leafC, NONE, (node_pk(p1), NONE), (node_pk(p3), NONE),
               (node_pk(p5), NONE)) in
  out(c, (gid, tree2, (N0, NONE), int2));
  (* What C holds as a member of epoch 2, and the admission it kept. *)
  out(c, (lsC, p5, p3, es2, admC));
  out(stRA, (gid, lsA, leafB, leafC, admC, es2, int2));
  out(stRB, (gid, leafA, leafB, lsB, leafC, p1, es2, int2)).

(* A removes C with a proposal it signs as admin (section 10.1) and
   re-keys. The removal blanks C's leaf and its direct path, the tree halves
   to width 2, and A's new root secret goes to B's leaf only. *)
let RM_A3 =
  let pkA = spk(skA) in
  in(stRA, (gid: bitstring, lsA: key, leafB: bitstring, leafC: bitstring,
            admC: bitstring, es2: key, int2: bitstring));
  let (pkB: spkey, sinceB: bitstring, lkB: kpk, admB: bitstring) = leafB in
  let (pkC: spkey, sinceC: bitstring, lkC: kpk, hC: bitstring) = leafC in
  let rp = sign(skA, CTX_REMOVE, (gid, N2, sinceC, pkA)) in
  new lsA3: key;
  let q1 = path_secret(lsA3) in
  new r3: key;
  let wc3 = wrap_ctx(gid, N3, N0, N1, N2, lkB) in
  let ss3 = kemss(lkB, r3) in
  let tree3 = ((pkA, N0, leaf_pk(lsA3), NOADM), leafB, (node_pk(q1), NONE)) in
  let reg3 = (N0, hC) in
  let th3 = hash(tree3) in
  let rh3 = hash(reg3) in
  let tbs3 = (gid, N3, K_member, int2, N0, th3, rh3, rp,
              (leaf_pk(lsA3), node_pk(q1), kemct(lkB, r3),
               wrapk(wrap_key(ss3, wc3), wrap_nonce(ss3, wc3), wc3, q1)),
              NONE, pkA) in
  let sig3 = sign(skA, CTX_ANCHOR, tbs3) in
  let cth3 = confirmed_th(sig3, NONE) in
  let gc3 = (gid, N3, th3, rh3, cth3) in
  let es3 = epoch_secret(joiner_secret(init_secret(es2), path_secret(q1), gc3)) in
  let tag3 = mac(confirm_key(es3), cth3) in
  event Committed(pkA, N3, gc3);
  event Accepted(pkA, N3, gc3, es3);
  let gi3 = (gc3, tag3, kempk(external_sk(es3)), N0) in
  out(c, (tbs3, sig3, tag3, gi3, sign(skA, CTX_GROUP_INFO, gi3), tree3, reg3));
  (* A admits a new device, D. *)
  event Admitted(pkA, gid, spk(skD));
  out(c, sign(skA, CTX_ADMISSION, (gid, device_id(gid, spk(skD)))));
  out(stRA3, (gid, lsA3, leafB, hC, q1, es3, interim_th(cth3, tag3))).

(* B processes the commit of epoch 3 that removes C: the removal is
   proposed by an admin (A) or by C itself (a leave). With [checked], a
   removal never targets the commit's author (section 9.4). *)
let RM_B3(checked: bool) =
  let pkA = spk(skA) in
  let pkB = spk(skB) in
  in(stRB, (gid: bitstring, leafA: bitstring, leafB: bitstring, lsB: key,
            leafC: bitstring, p1: key, es2: key, int2: bitstring));
  let (pkC: spkey, sinceC: bitstring, lkC: kpk, hC: bitstring) = leafC in
  in(c, (tbs3: bitstring, sig3: bitstring, tag3: bitstring));
  let (=gid, =N3, kind: bitstring, =int2, author: bitstring, th3: bitstring,
       rh3: bitstring, rp: bitstring, path: bitstring, ext: bitstring,
       pkAu: spkey) = tbs3 in
  if verify(pkAu, CTX_ANCHOR, tbs3, sig3) = true then
  if verify(pkA, CTX_REMOVE, (gid, N2, sinceC, pkA), rp) = true
     || verify(pkC, CTX_REMOVE, (gid, N2, sinceC, pkC), rp) = true then
  if rh3 = hash((N0, hC)) then
  if kind = K_member && author = N0 && pkAu = pkA then
  (
    (* A's Member commit: the tree halves; A's root secret goes to B's
       leaf. *)
    let (leafA3: kpk, n1: kpk, ctw: bitstring, w: bitstring) = path in
    let wc3 = wrap_ctx(gid, N3, N0, N1, N2, leaf_pk(lsB)) in
    let ss3 = decaps(leaf_sk(lsB), ctw) in
    let q1 = unwrapk(wrap_key(ss3, wc3), wrap_nonce(ss3, wc3), wc3, w) in
    if n1 = node_pk(q1) then
    let (=pkA, sinceA: bitstring, lkA: kpk, admA: bitstring) = leafA in
    if th3 = hash(((pkA, sinceA, leafA3, admA), leafB, (n1, NONE))) then
    let cth3 = confirmed_th(sig3, NONE) in
    let gc3 = (gid, N3, th3, rh3, cth3) in
    let es3 = epoch_secret(joiner_secret(init_secret(es2), path_secret(q1), gc3)) in
    if tag3 = mac(confirm_key(es3), cth3) then
    event Accepted(pkB, N3, gc3, es3)
  )
  else if checked = false && kind = K_resync && author = N2 && pkAu = pkC then
  (
    (* Without the rule: C's Resync includes its own removal, then
       re-enters its leaf (section 9.4, step 4) with a new occupancy. Its
       root path secret is wrapped to node 1, whose key B holds; the
       epoch uses the external init of epoch 2. *)
    let (leafC3: kpk, n5: kpk, n3: kpk, ctw: bitstring, w: bitstring) = path in
    let wc3 = wrap_ctx(gid, N3, N2, N3, N1, node_pk(p1)) in
    let ss3 = decaps(node_sk(p1), ctw) in
    let q3 = unwrapk(wrap_key(ss3, wc3), wrap_nonce(ss3, wc3), wc3, w) in
    if n3 = node_pk(q3) then
    if th3 = hash((leafA, leafB, (pkC, N3, leafC3, hC),
                   NONE, (node_pk(p1), NONE), (n3, NONE), (n5, NONE))) then
    let ssx = decaps(external_sk(es2), ext) in
    let cth3 = confirmed_th(sig3, NONE) in
    let gc3 = (gid, N3, th3, rh3, cth3) in
    let es3 = epoch_secret(joiner_secret(external_init(ssx, ext), path_secret(q3), gc3)) in
    if tag3 = mac(confirm_key(es3), cth3) then
    event Accepted(pkB, N3, gc3, es3)
  ).

(* A processes the ExternalJoin of some device X in epoch 4. X needs an
   admission from A and must not be a member. With [checked], an admission
   that is retired cannot be used (section 7). *)
let RM_A4(checked: bool) =
  let pkA = spk(skA) in
  in(stRA3, (gid: bitstring, lsA3: key, leafB: bitstring, hC: bitstring, q1: key,
             es3: key, int3: bitstring));
  let (pkB: spkey, sinceB: bitstring, lkB: kpk, admB: bitstring) = leafB in
  in(c, (tbs4: bitstring, sig4: bitstring, tag4: bitstring));
  let (=gid, =N4, =K_join, =int3, =N2, th4: bitstring, rh4: bitstring,
       (leafX: kpk, n5: kpk, n3: kpk, ctw4: bitstring, w4: bitstring),
       ctx4: bitstring, adm4: bitstring, pkX: spkey) = tbs4 in
  if verify(pkX, CTX_ANCHOR, tbs4, sig4) = true then
  if verify(pkA, CTX_ADMISSION, (gid, device_id(gid, pkX)), adm4) = true then
  if pkX <> pkA && pkX <> pkB then
  if checked = true && hash(adm4) = hC then 0 else
  let wc4 = wrap_ctx(gid, N4, N2, N3, N1, node_pk(q1)) in
  let ss4 = decaps(node_sk(q1), ctw4) in
  let ps3 = unwrapk(wrap_key(ss4, wc4), wrap_nonce(ss4, wc4), wc4, w4) in
  if n3 = node_pk(ps3) then
  if th4 = hash(((pkA, N0, leaf_pk(lsA3), NOADM), leafB, (pkX, N4, leafX, hash(adm4)),
                 NONE, (node_pk(q1), NONE), (n3, NONE), (n5, NONE))) then
  if rh4 = hash((N0, hC)) then
  let ssx = decaps(external_sk(es3), ctx4) in
  let cth4 = confirmed_th(sig4, NONE) in
  let gc4 = (gid, N4, th4, rh4, cth4) in
  let es4 = epoch_secret(joiner_secret(external_init(ssx, ctx4), path_secret(ps3), gc4)) in
  if tag4 = mac(confirm_key(es4), cth4) then
  event AcceptedJoin(pkA, N4, pkX);
  event Accepted(pkA, N4, gc4, es4).

(* D, an honest device, enters in epoch 4 from A's GroupInfo of epoch 3,
   checked under A's key. *)
let RM_D4 =
  let pkA = spk(skA) in
  let pkD = spk(skD) in
  in(c, (gi3: bitstring, gisig3: bitstring, tree3: bitstring, reg3: bitstring,
         adm: bitstring));
  if verify(pkA, CTX_GROUP_INFO, gi3, gisig3) = true then
  let ((gid: bitstring, =N3, th3: bitstring, rh3: bitstring, cth3: bitstring),
       tag3: bitstring, extpk3: kpk, =N0) = gi3 in
  if th3 = hash(tree3) then
  if rh3 = hash(reg3) then
  let ((=pkA, sinceA: bitstring, lkA: kpk, admA: bitstring), leafB: bitstring,
       (n1: kpk, =NONE)) = tree3 in
  if verify(pkA, CTX_ADMISSION, (gid, device_id(gid, pkD)), adm) = true then
  new rx: key;
  let ctx4 = kemct(extpk3, rx) in
  let init4 = external_init(kemss(extpk3, rx), ctx4) in
  new lsD: key;
  let d5 = path_secret(lsD) in
  let d3 = path_secret(d5) in
  new r4: key;
  let wc4 = wrap_ctx(gid, N4, N2, N3, N1, n1) in
  let ss4 = kemss(n1, r4) in
  let th4 = hash(((pkA, sinceA, lkA, admA), leafB, (pkD, N4, leaf_pk(lsD), hash(adm)),
                  NONE, (n1, NONE), (node_pk(d3), NONE), (node_pk(d5), NONE))) in
  let tbs4 = (gid, N4, K_join, interim_th(cth3, tag3), N2, th4, rh3,
              (leaf_pk(lsD), node_pk(d5), node_pk(d3), kemct(n1, r4),
               wrapk(wrap_key(ss4, wc4), wrap_nonce(ss4, wc4), wc4, d3)),
              ctx4, adm, pkD) in
  let sig4 = sign(skD, CTX_ANCHOR, tbs4) in
  let cth4 = confirmed_th(sig4, NONE) in
  let gc4 = (gid, N4, th4, rh3, cth4) in
  let es4 = epoch_secret(joiner_secret(init4, path_secret(d3), gc4)) in
  let tag4 = mac(confirm_key(es4), cth4) in
  event Committed(pkD, N4, gc4);
  event Accepted(pkD, N4, gc4, es4);
  out(c, (tbs4, sig4, tag4)).

(* ============ Scenario RT: rotation of a device key ============

   The group is at epoch 1 with A (leaf 0, admin) and B (leaf 1, device key
   skB), width 2, root node 1.
   Epoch 2: B rotates its device key to skB2 with a Member commit signed by
            skB, with a rotation signature by skB2 (sections 9.2, 9.3), and
            sends a message signed with skB2. A processes the commit and
            takes skB2 as the key of B's occupancy.
   Epoch 3: A processes a commit authored by B's leaf, and a message of
            epoch 2 from B's occupancy.
   The old key skB leaks once A accepted the rotation. *)

free stTA, stTB, stTA2, rotated: channel [private].

let RT_Setup =
  let pkA = spk(skA) in
  let pkB = spk(skB) in
  new nonce: bitstring;
  let gid = hash((pkA, nonce)) in
  new lsA: key; new lsB: key;
  new p1: key;
  new es1: key;
  new int1: bitstring;
  new admB: bitstring;
  let leafA = (pkA, N0, leaf_pk(lsA), NOADM) in
  let leafB = (pkB, N1, leaf_pk(lsB), admB) in
  out(c, (gid, (leafA, leafB, (node_pk(p1), NONE)), (N0, NONE), int1));
  out(stTA, (gid, lsA, leafB, es1, int1));
  out(stTB, (gid, leafA, admB, es1, int1)).

(* B rotates to skB2 and re-keys; the new root path secret goes to A's
   leaf. It then sends a message of epoch 2 signed with skB2, and authors
   the next commit, a self-update. *)
let RT_B =
  let pkA = spk(skA) in
  let pkB = spk(skB) in
  let pkB2 = spk(skB2) in
  in(stTB, (gid: bitstring, leafA: bitstring, admB: bitstring, es1: key, int1: bitstring));
  let (=pkA, sinceA: bitstring, lkA: kpk, admA: bitstring) = leafA in
  new lsB2: key;
  let psB2 = path_secret(lsB2) in
  new r2: key;
  let wc2 = wrap_ctx(gid, N2, N1, N1, N0, lkA) in
  let ss2 = kemss(lkA, r2) in
  let th2 = hash((leafA, (pkB2, N1, leaf_pk(lsB2), admB), (node_pk(psB2), NONE))) in
  let rh = hash((N0, NONE)) in
  let tbs2 = (gid, N2, K_member, int1, N1, th2, rh,
              (leaf_pk(lsB2), node_pk(psB2), kemct(lkA, r2),
               wrapk(wrap_key(ss2, wc2), wrap_nonce(ss2, wc2), wc2, psB2)),
              pkB, pkB2) in
  let sig2 = sign(skB, CTX_ANCHOR, tbs2) in
  let rot2 = sign(skB2, CTX_ROTATION, tbs2) in
  let cth2 = confirmed_th(sig2, rot2) in
  let gc2 = (gid, N2, th2, rh, cth2) in
  let es2 = epoch_secret(joiner_secret(init_secret(es1), path_secret(psB2), gc2)) in
  let tag2 = mac(confirm_key(es2), cth2) in
  event Committed(pkB2, N2, gc2);
  event Accepted(pkB2, N2, gc2, es2);
  out(c, (tbs2, sig2, rot2, tag2));
  (* A message of epoch 2 from B's occupancy [leaf 1, since 1]. *)
  new m: bitstring;
  event Sent(pkB2, N2, m);
  let fc = (gid, N2, (N1, N1), m) in
  let hdr = (hash((gid, N2)), (N1, N1)) in
  out(c, (hdr, aenc(msg_key(es2, (N1, N1)), msg_nonce(es2, (N1, N1)), hdr,
                    (fc, sign(skB2, CTX_MSG, fc)))));
  (* The next commit: a self-update signed with the new key. *)
  new lsB3: key;
  let psB3 = path_secret(lsB3) in
  new r3: key;
  let wc3 = wrap_ctx(gid, N3, N1, N1, N0, lkA) in
  let ss3 = kemss(lkA, r3) in
  let th3 = hash((leafA, (pkB2, N1, leaf_pk(lsB3), admB), (node_pk(psB3), NONE))) in
  let tbs3 = (gid, N3, K_member, interim_th(cth2, tag2), N1, th3, rh,
              (leaf_pk(lsB3), node_pk(psB3), kemct(lkA, r3),
               wrapk(wrap_key(ss3, wc3), wrap_nonce(ss3, wc3), wc3, psB3)),
              pkB2, NONE) in
  let sig3 = sign(skB2, CTX_ANCHOR, tbs3) in
  let cth3 = confirmed_th(sig3, NONE) in
  let gc3 = (gid, N3, th3, rh, cth3) in
  let es3 = epoch_secret(joiner_secret(init_secret(es2), path_secret(psB3), gc3)) in
  let tag3 = mac(confirm_key(es3), cth3) in
  event Committed(pkB2, N3, gc3);
  event Accepted(pkB2, N3, gc3, es3);
  out(c, (tbs3, sig3, tag3)).

(* A processes epoch 2. A commit of B's leaf is signed by the key of the
   leaf in epoch 1; when it names a new key, the rotation signature must
   verify under it and the key must not be a member's (sections 9.2,
   9.4). *)
let RT_A2 =
  let pkA = spk(skA) in
  in(stTA, (gid: bitstring, lsA: key, leafB: bitstring, es1: key, int1: bitstring));
  let (pkB: spkey, sinceB: bitstring, lkB: kpk, admB: bitstring) = leafB in
  in(c, (tbs2: bitstring, sig2: bitstring, rot2: bitstring, tag2: bitstring));
  let (=gid, =N2, =K_member, =int1, =N1, th2: bitstring, rh: bitstring,
       (leafB2: kpk, n1: kpk, ctw: bitstring, w: bitstring),
       =pkB, newpk: spkey) = tbs2 in
  if verify(pkB, CTX_ANCHOR, tbs2, sig2) = true then
  if verify(newpk, CTX_ROTATION, tbs2, rot2) = true then
  if newpk <> pkA && newpk <> pkB then
  let wc2 = wrap_ctx(gid, N2, N1, N1, N0, leaf_pk(lsA)) in
  let ss2 = decaps(leaf_sk(lsA), ctw) in
  let ps2 = unwrapk(wrap_key(ss2, wc2), wrap_nonce(ss2, wc2), wc2, w) in
  if n1 = node_pk(ps2) then
  if th2 = hash(((pkA, N0, leaf_pk(lsA), NOADM), (newpk, sinceB, leafB2, admB),
                 (n1, NONE))) then
  if rh = hash((N0, NONE)) then
  let cth2 = confirmed_th(sig2, rot2) in
  let gc2 = (gid, N2, th2, rh, cth2) in
  let es2 = epoch_secret(joiner_secret(init_secret(es1), path_secret(ps2), gc2)) in
  if tag2 = mac(confirm_key(es2), cth2) then
  event AcceptedCommit(pkA, N2, pkB, gc2);
  event Accepted(pkA, N2, gc2, es2);
  out(rotated, ());
  out(stTA2, (gid, lsA, newpk, sinceB, admB, rh, es2, interim_th(cth2, tag2))).

(* A processes a message of epoch 2 from B's occupancy, verified under the
   key B held in that epoch (section 11.3), and the commit of epoch 3, whose
   author must hold the current key of B's leaf. *)
let RT_A3 =
  let pkA = spk(skA) in
  in(stTA2, (gid: bitstring, lsA: key, pkB: spkey, sinceB: bitstring, admB: bitstring,
             rh: bitstring, es2: key, int2: bitstring));
  (
    in(c, (hdr: bitstring, ct: bitstring));
    if hdr = (hash((gid, N2)), (N1, sinceB)) then
    let (fc: bitstring, fsig: bitstring) =
      adec(msg_key(es2, (N1, sinceB)), msg_nonce(es2, (N1, sinceB)), hdr, ct) in
    let (=gid, =N2, =(N1, sinceB), m: bitstring) = fc in
    if verify(pkB, CTX_MSG, fc, fsig) = true then
    event Received(pkA, pkB, N2, m)
  ) | (
    in(c, (tbs3: bitstring, sig3: bitstring, tag3: bitstring));
    let (=gid, =N3, =K_member, =int2, =N1, th3: bitstring, =rh,
         (leafB3: kpk, n1: kpk, ctw: bitstring, w: bitstring),
         author: spkey, =NONE) = tbs3 in
    if author = pkB then
    if verify(author, CTX_ANCHOR, tbs3, sig3) = true then
    let wc3 = wrap_ctx(gid, N3, N1, N1, N0, leaf_pk(lsA)) in
    let ss3 = decaps(leaf_sk(lsA), ctw) in
    let ps3 = unwrapk(wrap_key(ss3, wc3), wrap_nonce(ss3, wc3), wc3, w) in
    if n1 = node_pk(ps3) then
    if th3 = hash(((pkA, N0, leaf_pk(lsA), NOADM), (pkB, sinceB, leafB3, admB),
                   (n1, NONE))) then
    let cth3 = confirmed_th(sig3, NONE) in
    let gc3 = (gid, N3, th3, rh, cth3) in
    let es3 = epoch_secret(joiner_secret(init_secret(es2), path_secret(ps3), gc3)) in
    if tag3 = mac(confirm_key(es3), cth3) then
    event AcceptedCommit(pkA, N3, author, gc3);
    event Accepted(pkA, N3, gc3, es3)
  ).

(* The old key leaks once A accepted the rotation. *)
let RT_Leak = in(rotated, x: bitstring); out(c, skB).

(* ============ Scenario MS: messages (section 11) ============ *)

let SendMsg(sk: skey, gid: bitstring, n: bitstring, es: key, sender: bitstring) =
  new m: bitstring;
  event Sent(spk(sk), n, m);
  let fc = (gid, n, sender, m) in
  let hdr = (hash((gid, n)), sender) in
  out(c, (hdr, aenc(msg_key(es, sender), msg_nonce(es, sender), hdr,
                    (fc, sign(sk, CTX_MSG, fc))))).

(* A receiver takes the sender's key from the tree (here [from], the member
   of the occupancy [sender]), derives the key of its chain, checks that the
   framed content matches the envelope, and verifies the signature under
   CTX_MSG before releasing the plaintext (section 11.3). *)
let RecvMsg(me: spkey, from: spkey, gid: bitstring, n: bitstring, es: key,
            sender: bitstring) =
  in(c, (hdr: bitstring, ct: bitstring));
  if hdr = (hash((gid, n)), sender) then
  let (fc: bitstring, fsig: bitstring) =
    adec(msg_key(es, sender), msg_nonce(es, sender), hdr, ct) in
  let (=gid, =n, =sender, m: bitstring) = fc in
  if verify(from, CTX_MSG, fc, fsig) = true then
  event Received(me, from, n, m).

(* Group 1 (epoch N1): A (occupancy [0, 0]), B and C, a malicious member
   that knows the epoch secret. Group 2 (epoch N2): A and B only. A also
   signs anything the adversary asks under another context, as it does for
   its commits. *)
let MS =
  let pkA = spk(skA) in
  let pkB = spk(skB) in
  new gid1: bitstring;
  new es1: key;
  out(c, (gid1, es1));
  new gid2: bitstring;
  new es2: key;
  out(c, gid2);
  (SendMsg(skA, gid1, N1, es1, (N0, N0))
   | RecvMsg(pkB, pkA, gid1, N1, es1, (N0, N0))
   | SendMsg(skA, gid2, N2, es2, (N0, N0))
   | RecvMsg(pkB, pkA, gid2, N2, es2, (N0, N0))
   | (!in(c, x: bitstring); out(c, sign(skA, CTX_ANCHOR, x)))).
