(* City-G symbolic model: shared definitions.

   Symbolic (Dolev-Yao) model of the design choices of City-G
   (docs/design.md, docs/research/grands-groupes-2026-09-25.md): epochs
   sealed per window, districts re-keyed by committers that need not belong
   to them, a sealer re-keying the city above them, taints, district
   welcomes and anchored joins.
   The scenarios named island_*, flat_* and refresh_* model stage 1 of
   profile city-g/v0.5-draft (docs/specs-v0.5-draft.md, section 2): islands
   read through relay elements, flat elements and refreshes.
   Primitives are ideal: the X-Wing wrap of a secret is one ideal public-key
   encryption, ML-DSA-65 an unforgeable signature, BLAKE3 and its keyed modes
   one-way functions. Trees are written out in each scenario. *)

type key.      (* 32-byte secrets and seeds *)
type skey.     (* ML-DSA-65 device key *)
type spkey.    (* its public key *)
type kpk.      (* X-Wing encapsulation key *)

free c: channel.

const N1, N2: bitstring.          (* epochs *)
const D1, D2, CITY: bitstring.    (* commit scopes *)
const L_path, L_node, L_leaf, L_epoch, L_init, L_confirm, L_msg, L_external: bitstring.
const ADMIT: bitstring.            (* label of an admission *)

(* ---------- BLAKE3 ---------- *)

fun hash(bitstring): bitstring.
fun kdf(key, bitstring): key.              (* ExpandLabel(secret, label) *)
fun kdf2(key, key, bitstring): key.        (* Extract(init, root), then ExpandLabel with the context *)
fun kdf_root(key, bitstring): key.         (* variant without init chain: KDF(root, context) *)
fun mac(key, bitstring): bitstring.

(* ---------- X-Wing wrap of a 32-byte secret (KEM and AEAD folded) ---------- *)

fun kempk(key): kpk.
fun wrap(kpk, key, key): bitstring.        (* recipient key, randomness, secret *)
reduc forall sk: key, r: key, m: key; unwrap(sk, wrap(kempk(sk), r, m)) = m.

(* Whoever knows the coins of an encapsulation opens it: the KEM is
   deterministic given them, so the shared secret, then the plaintext,
   follow (the scenarios task_hedge*, stage 2). *)
reduc forall pk: kpk, r: key, m: key; open_coins(r, wrap(pk, r, m)) = m.

(* ---------- ChaCha20-Poly1305 for application messages ---------- *)

fun aenc(key, bitstring): bitstring.
reduc forall k: key, m: bitstring; adec(k, aenc(k, m)) = m.

(* ---------- ML-DSA-65 ---------- *)

fun spk(skey): spkey.
fun sign(skey, bitstring): bitstring.
reduc forall sk: skey, m: bitstring; checksign(spk(sk), m, sign(sk, m)) = true.

(* ---------- Tree keys ---------- *)

letfun node_sk(s: key) = kdf(s, L_node).
letfun node_pk(s: key) = kempk(node_sk(s)).
letfun leaf_sk(ls: key) = kdf(ls, L_leaf).
letfun leaf_pk(ls: key) = kempk(leaf_sk(ls)).

(* ---------- Key schedule ---------- *)

(* With the init chain (docs/specs.md, section 9): the root secret of the
   window goes through the joiner secret, which district welcomes carry. *)
letfun joiner_secret(init_prev: key, root: key, gc: bitstring) = kdf2(init_prev, root, gc).
letfun epoch_secret(js: key) = kdf(js, L_epoch).
letfun init_secret(es: key) = kdf(es, L_init).

(* Without the init chain: the epoch secret derives from the root alone. *)
letfun epoch_secret_noinit(root: key, gc: bitstring) = kdf_root(root, gc).

(* External init (a window sealed by an entrant): every member of the epoch
   derives the external key pair from the epoch secret; the entrant wraps a
   fresh init secret to its public key, in place of the init chain. *)
letfun external_sk(es: key) = kdf(es, L_external).
letfun external_pk(es: key) = kempk(external_sk(es)).

letfun confirm_key(es: key) = kdf(es, L_confirm).
letfun msg_key(es: key) = kdf(es, L_msg).
letfun tag(es: key, gc: bitstring) = mac(confirm_key(es), hash(gc)).

(* ---------- X-Wing as a KEM, for the welcome of a catch-up ---------- *)

(* A catch-up's welcome is sealed under a key derived from two
   encapsulations, to the request's one-time init key and to the member's
   leaf key (docs/specs.md, section 11). *)
const L_welcome: bitstring.
fun kem_ct(kpk, key): bitstring.           (* recipient key, coins *)
fun kem_ss(kpk, key): key.
reduc forall sk: key, r: key; decaps(sk, kem_ct(kempk(sk), r)) = kem_ss(kempk(sk), r).
fun senc(key, key): bitstring.             (* ChaCha20-Poly1305 of a secret *)
reduc forall k: key, m: key; sdec(k, senc(k, m)) = m.

(* ---------- Islands (docs/specs-v0.5-draft.md, section 2) ---------- *)

const N3: bitstring.               (* a third epoch *)
const I0, I1, I2: bitstring.       (* islands *)
const L_relay: bitstring.

(* A node's secret chained from its child's (docs/specs.md, section 7). *)
letfun chain(s: key) = kdf(s, L_path).

(* The key of a relay element: derived from the secret of the island root
   and the element's context (window and island); ChaCha20-Poly1305 of the
   root secret is senc. *)
letfun relay_key(s: key, ctx: bitstring) = kdf(s, (L_relay, ctx)).

(* One step of a refresh, from the level below: a Wrap of the node's secret
   to the key of the level below, or a Chain from it. *)
fun wrap_step(bitstring): bitstring [data].
const chain_step: bitstring.
fun up(key, bitstring): key
reduc forall s: key, r: key, m: key;
    up(s, wrap_step(wrap(kempk(kdf(s, L_node)), r, m))) = m
otherwise forall s: key;
    up(s, chain_step) = kdf(s, L_path).

(* ---------- Tasks (docs/specs-v0.5-draft.md, section 3) ---------- *)

const L_hedge, L_fresh, L_coins, CITY_TASK: bitstring.

(* The hedge of a performer: ExpandLabel(leaf_seed, "task hedge", [gid,
   epoch]), from the seed of its leaf key, which only it holds. *)
letfun task_hedge(ls: key, ctx: bitstring) = kdf(ls, (L_hedge, ctx)).

(* A fresh secret, and the coins of an encapsulation, from a random value
   of the generator and a hedge: DeriveSecret(Extract(hedge, r), "fresh
   node"), ExpandLabel(Extract(hedge, r), "encaps coins", context). *)
letfun fresh(h: key, rnd: key) = kdf2(h, rnd, L_fresh).
letfun coins(h: key, rnd: key) = kdf2(h, rnd, L_coins).
