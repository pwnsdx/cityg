(* City-G "Cite" research model: shared definitions.

   Symbolic (Dolev-Yao) model of the design studied in
   docs/research/grands-groupes-2026-09-25.md: epochs sealed per window,
   districts re-keyed by committers that need not belong to them, a city
   committer above them, taints, district welcomes and anchored joins.
   Primitives are ideal: the X-Wing wrap of a secret is one ideal public-key
   encryption, ML-DSA-65 an unforgeable signature, BLAKE3 and its keyed modes
   one-way functions. Trees are written out in each scenario. *)

type key.      (* 32-byte secrets and seeds *)
type skey.     (* ML-DSA-65 device key *)
type spkey.    (* its public key *)
type kpk.      (* X-Wing encapsulation key *)

free c: channel.

const N1, N2: bitstring.          (* epochs *)
const D1, D2, CITY: bitstring.    (* commit scopes *)
const L_path, L_node, L_leaf, L_epoch, L_init, L_confirm, L_msg, L_external: bitstring.
const ADMIT: bitstring.            (* label of an admission *)

(* ---------- BLAKE3 ---------- *)

fun hash(bitstring): bitstring.
fun kdf(key, bitstring): key.              (* ExpandLabel(secret, label) *)
fun kdf2(key, key, bitstring): key.        (* Extract(init, root), then ExpandLabel with the context *)
fun kdf_root(key, bitstring): key.         (* variant without init chain: KDF(root, context) *)
fun mac(key, bitstring): bitstring.

(* ---------- X-Wing wrap of a 32-byte secret (KEM and AEAD folded) ---------- *)

fun kempk(key): kpk.
fun wrap(kpk, key, key): bitstring.        (* recipient key, randomness, secret *)
reduc forall sk: key, r: key, m: key; unwrap(sk, wrap(kempk(sk), r, m)) = m.

(* ---------- ChaCha20-Poly1305 for application messages ---------- *)

fun aenc(key, bitstring): bitstring.
reduc forall k: key, m: bitstring; adec(k, aenc(k, m)) = m.

(* ---------- ML-DSA-65 ---------- *)

fun spk(skey): spkey.
fun sign(skey, bitstring): bitstring.
reduc forall sk: skey, m: bitstring; checksign(spk(sk), m, sign(sk, m)) = true.

(* ---------- Tree keys ---------- *)

letfun node_sk(s: key) = kdf(s, L_node).
letfun node_pk(s: key) = kempk(node_sk(s)).
letfun leaf_sk(ls: key) = kdf(ls, L_leaf).
letfun leaf_pk(ls: key) = kempk(leaf_sk(ls)).

(* ---------- Key schedule ---------- *)

(* With the init chain (as in profile v0.3, section 8): the root secret of
   the window goes through the joiner secret, which district welcomes carry. *)
letfun joiner_secret(init_prev: key, root: key, gc: bitstring) = kdf2(init_prev, root, gc).
letfun epoch_secret(js: key) = kdf(js, L_epoch).
letfun init_secret(es: key) = kdf(es, L_init).

(* Without the init chain: the epoch secret derives from the root alone. *)
letfun epoch_secret_noinit(root: key, gc: bitstring) = kdf_root(root, gc).

(* External init (a window sealed by an entrant): every member of the epoch
   derives the external key pair from the epoch secret; the entrant wraps a
   fresh init secret to its public key, in place of the init chain. *)
letfun external_sk(es: key) = kdf(es, L_external).
letfun external_pk(es: key) = kempk(external_sk(es)).

letfun confirm_key(es: key) = kdf(es, L_confirm).
letfun msg_key(es: key) = kdf(es, L_msg).
letfun tag(es: key, gc: bitstring) = mac(confirm_key(es), hash(gc)).
