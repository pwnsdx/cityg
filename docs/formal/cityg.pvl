(* City-G profile v0.2: symbolic model, shared definitions and scenarios.

   Primitives are ideal (Dolev-Yao): ML-KEM-768 is an IND-CCA2 KEM,
   ChaCha20-Poly1305 an ideal AEAD, ML-DSA-87 an unforgeable signature bound
   to its FIPS 204 context string, BLAKE3 and its keyed modes one-way
   functions. Section numbers refer to docs/specs.md; README.md lists the
   abstractions. *)

type key.      (* 32-byte secrets, seeds, nonces *)
type skey.     (* ML-DSA-87 device key *)
type spkey.    (* its public key *)
type kpk.      (* ML-KEM-768 encapsulation key *)

free c: channel.

const ZERO: key.
const NONE: bitstring.

(* Epochs, slots and tree nodes. *)
const N0, N1, N2, N3, N4, N5, N6: bitstring.

(* Derivation labels (section 16.2) *)
const L_tree_path, L_node_key, L_leaf_key, L_commit, L_epoch, L_init, L_msg,
      L_confirm, L_external, L_ext_kem, L_ext_init, L_wrap_key,
      L_wrap_nonce, L_msg_sender, L_msg_key, L_msg_nonce: bitstring.

(* Commit kinds (section 9.1) *)
const K_genesis, K_member, K_join: bitstring.

(* Signature contexts (section 16.3) *)
const CTX_ANCHOR, CTX_GROUP_INFO, CTX_ADMISSION, CTX_REMOVE, CTX_MSG: bitstring.

(* ---------- BLAKE3: H, Extract, ExpandLabel, MAC (section 4) ---------- *)

fun hash(bitstring): bitstring.
fun extract(key, key): key.
fun expand_label(key, bitstring, bitstring): key.
fun mac(key, bitstring): bitstring.

letfun derive(s: key, l: bitstring) = expand_label(s, l, NONE).

(* ---------- ML-KEM-768 ---------- *)

fun kempk(key): kpk.
fun kemct(kpk, key): bitstring.     (* encapsulation with randomness r *)
fun kemss(kpk, key): key.
reduc forall s: key, r: key; decaps(s, kemct(kempk(s), r)) = kemss(kempk(s), r).

(* ---------- ChaCha20-Poly1305 ---------- *)

fun wrapk(key, key, bitstring, key): bitstring.
reduc forall k: key, n: key, ad: bitstring, m: key;
  unwrapk(k, n, ad, wrapk(k, n, ad, m)) = m.

fun aenc(key, key, bitstring, bitstring): bitstring.
reduc forall k: key, n: key, ad: bitstring, m: bitstring;
  adec(k, n, ad, aenc(k, n, ad, m)) = m.

(* ---------- ML-DSA-87 with contexts ---------- *)

fun spk(skey): spkey.
fun sign(skey, bitstring, bitstring): bitstring.
reduc forall sk: skey, ctx: bitstring, m: bitstring;
  verify(spk(sk), ctx, m, sign(sk, ctx, m)) = true.

(* ---------- Protocol functions ---------- *)

(* Identifiers (section 5) *)
letfun leaf_id(gid: bitstring, pk: spkey) = hash((gid, pk)).

(* Leaf and node keys (section 6.3). Members keep KEM seeds, never the leaf
   secret they drew. *)
letfun leaf_sk(ls: key) = expand_label(ls, L_leaf_key, NONE).
letfun leaf_pk(ls: key) = kempk(leaf_sk(ls)).
letfun path_secret(s: key) = derive(s, L_tree_path).
letfun node_sk(ps: key) = expand_label(ps, L_node_key, NONE).
letfun node_pk(ps: key) = kempk(node_sk(ps)).

(* Wrap of a path secret to a target key (section 6.3). *)
letfun wrap_ctx(gid: bitstring, epoch: bitstring, author: bitstring,
                node: bitstring, target: bitstring, pk: kpk) =
  (gid, epoch, author, node, target, pk).
letfun wrap_key(ss: key, ctx: bitstring) = expand_label(ss, L_wrap_key, ctx).
letfun wrap_nonce(ss: key, ctx: bitstring) = expand_label(ss, L_wrap_nonce, ctx).

(* Key schedule (section 8). *)
letfun commit_secret(root_ps: key) = derive(root_ps, L_commit).
letfun epoch_secret(init_prev: key, cs: key, gc: bitstring) =
  expand_label(extract(init_prev, cs), L_epoch, hash(gc)).
letfun init_secret(es: key) = derive(es, L_init).
letfun confirm_key(es: key) = derive(es, L_confirm).
letfun msg_secret(es: key) = derive(es, L_msg).
letfun external_secret(es: key) = derive(es, L_external).
letfun external_sk(es: key) = expand_label(external_secret(es), L_ext_kem, NONE).
letfun external_init(ss: key, ct: bitstring) =
  expand_label(extract(ZERO, ss), L_ext_init, hash(ct)).

(* Transcript (section 8). The specification hashes the previous interim
   hash, anchor_tbs and the signature. A symbolic signature contains the
   signed message, and anchor_tbs contains the previous interim hash, so
   hashing the signature alone binds the same values with smaller terms. *)
letfun confirmed_th(sig: bitstring) = hash(sig).
letfun interim_th(cth: bitstring, tag: bitstring) = hash((cth, tag)).

(* Message plane (section 11.2): first key of a sender's chain. *)
letfun msg_key(es: key, sender: bitstring) =
  expand_label(expand_label(msg_secret(es), L_msg_sender, sender), L_msg_key, NONE).
letfun msg_nonce(es: key, sender: bitstring) =
  expand_label(expand_label(msg_secret(es), L_msg_sender, sender), L_msg_nonce, NONE).

(* ---------- Events ---------- *)

(* An honest member authored the commit creating epoch n with context gc. *)
event Committed(spkey, bitstring, bitstring).
(* An honest member accepted epoch n with context gc and epoch secret es. *)
event Accepted(spkey, bitstring, bitstring, key).
(* An admin signed an admission for a device key in a group. *)
event Admitted(spkey, bitstring, spkey).
(* An honest member accepted the join of a device in epoch n. *)
event AcceptedJoin(spkey, bitstring, spkey).
(* Messages *)
event Sent(spkey, bitstring, bitstring).
event Received(spkey, spkey, bitstring, bitstring).

(* Device keys of the honest members. *)
free skA, skB, skD: skey [private].

(* ============ Scenario KS: a group grows from genesis ============

   Epoch 0: A creates the group (genesis, section 9.3).
   Epoch 1: B joins with an ExternalJoin commit and an admission of A.
   Epoch 2: B re-keys from a fresh leaf secret (self-update).

   Tree of n_max = 2 slots: node N0 is the root, N1 the leaf of slot 0 (A),
   N2 the leaf of slot 1 (B). A tree is (slot 0, slot 1, root key); a roster
   is (member of slot 0, member of slot 1, admin).

   Each member is a chain of processes, one per epoch, handing its state
   over on a private channel. leakA2 carries what A holds after epoch 2,
   leakB1 what B holds after epoch 1; a scenario decides whether the
   adversary learns it. *)

free stA0, stA1, stB1, leakA2, leakB1: channel [private].

let KS_A0 =
  let pkA = spk(skA) in
  new nonce: bitstring;
  let gid = hash((pkA, nonce)) in
  let lidA = leaf_id(gid, pkA) in
  new lsA: key;
  let psA0 = path_secret(lsA) in
  let tree0 = ((lidA, leaf_pk(lsA)), NONE, node_pk(psA0)) in
  let th0 = hash(tree0) in
  let roster0 = ((lidA, pkA), NONE, pkA) in
  let rh0 = hash(roster0) in
  let tbs0 = (gid, N0, K_genesis, NONE, pkA, rh0, th0, nonce) in
  let sig0 = sign(skA, CTX_ANCHOR, tbs0) in
  let cth0 = confirmed_th(sig0) in
  let gc0 = (gid, N0, th0, rh0, cth0) in
  let es0 = epoch_secret(ZERO, commit_secret(psA0), gc0) in
  let tag0 = mac(confirm_key(es0), cth0) in
  let gi0 = (gc0, tag0, kempk(external_sk(es0)), lidA) in
  event Committed(pkA, N0, gc0);
  event Accepted(pkA, N0, gc0, es0);
  out(c, (tbs0, sig0, tag0, gi0, sign(skA, CTX_GROUP_INFO, gi0), tree0, roster0));
  (* A admits B's device (section 10.2, kind 0). *)
  event Admitted(pkA, gid, spk(skB));
  out(c, sign(skA, CTX_ADMISSION, (gid, leaf_id(gid, spk(skB)))));
  out(stA0, (gid, lidA, lsA, es0, interim_th(cth0, tag0))).

(* A processes the ExternalJoin of some device X (sections 8.1, 9.4). *)
let KS_A1 =
  let pkA = spk(skA) in
  in(stA0, (gid: bitstring, lidA: bitstring, lsA: key, es0: key, int0: bitstring));
  in(c, (tbs1: bitstring, sig1: bitstring, tag1: bitstring));
  let (=gid, =N1, =K_join, =int0, pkX: spkey, rh1: bitstring, th1: bitstring,
       leafX: kpk, ctw1: bitstring, w1: bitstring, ctx1: bitstring,
       adm1: bitstring) = tbs1 in
  if verify(pkX, CTX_ANCHOR, tbs1, sig1) = true then
  let lidX = leaf_id(gid, pkX) in
  (* The admission must be signed by an admin, here A. *)
  if verify(pkA, CTX_ADMISSION, (gid, lidX), adm1) = true then
  let wc1 = wrap_ctx(gid, N1, N1, N0, N1, leaf_pk(lsA)) in
  let ss1 = decaps(leaf_sk(lsA), ctw1) in
  let ps1 = unwrapk(wrap_key(ss1, wc1), wrap_nonce(ss1, wc1), wc1, w1) in
  (* Derived node keys must match the announced tree (section 6.3). *)
  if th1 = hash(((lidA, leaf_pk(lsA)), (lidX, leafX), node_pk(ps1))) then
  if rh1 = hash(((lidA, pkA), (lidX, pkX), pkA)) then
  let ssx = decaps(external_sk(es0), ctx1) in
  let cth1 = confirmed_th(sig1) in
  let gc1 = (gid, N1, th1, rh1, cth1) in
  let es1 = epoch_secret(external_init(ssx, ctx1), commit_secret(ps1), gc1) in
  if tag1 = mac(confirm_key(es1), cth1) then
  event AcceptedJoin(pkA, N1, pkX);
  event Accepted(pkA, N1, gc1, es1);
  out(stA1, (gid, lidA, lsA, pkX, lidX, rh1, es1, interim_th(cth1, tag1))).

(* A processes X's re-key. Then what A still holds may leak: its leaf and
   root private keys and the secrets kept until the next epoch (section 8);
   earlier epoch secrets and init secrets are erased. *)
let KS_A2 =
  let pkA = spk(skA) in
  in(stA1, (gid: bitstring, lidA: bitstring, lsA: key, pkX: spkey,
            lidX: bitstring, rh1: bitstring, es1: key, int1: bitstring));
  in(c, (tbs2: bitstring, sig2: bitstring, tag2: bitstring));
  let (=gid, =N2, =K_member, =int1, =pkX, =rh1, th2: bitstring, leafX2: kpk,
       ctw2: bitstring, w2: bitstring) = tbs2 in
  if verify(pkX, CTX_ANCHOR, tbs2, sig2) = true then
  let wc2 = wrap_ctx(gid, N2, N1, N0, N1, leaf_pk(lsA)) in
  let ss2 = decaps(leaf_sk(lsA), ctw2) in
  let ps2 = unwrapk(wrap_key(ss2, wc2), wrap_nonce(ss2, wc2), wc2, w2) in
  if th2 = hash(((lidA, leaf_pk(lsA)), (lidX, leafX2), node_pk(ps2))) then
  let cth2 = confirmed_th(sig2) in
  let gc2 = (gid, N2, th2, rh1, cth2) in
  let es2 = epoch_secret(init_secret(es1), commit_secret(ps2), gc2) in
  if tag2 = mac(confirm_key(es2), cth2) then
  event Accepted(pkA, N2, gc2, es2);
  out(leakA2, (leaf_sk(lsA), node_sk(ps2), init_secret(es2),
               external_secret(es2), msg_secret(es2))).

(* B joins from A's signed GroupInfo (section 10.3) with an external commit
   (section 8.1). What B holds after epoch 1 may leak. *)
let KS_B1 =
  let pkA = spk(skA) in
  let pkB = spk(skB) in
  in(c, (gi0: bitstring, gisig0: bitstring, tree0: bitstring, roster0: bitstring,
         adm: bitstring));
  if verify(pkA, CTX_GROUP_INFO, gi0, gisig0) = true then
  let ((gid: bitstring, =N0, th0: bitstring, rh0: bitstring, cth0: bitstring),
       tag0: bitstring, extpk0: kpk, lidA: bitstring) = gi0 in
  if lidA = leaf_id(gid, pkA) then
  if th0 = hash(tree0) then
  if rh0 = hash(roster0) then
  let ((=lidA, leafA: kpk), =NONE, rootA0: kpk) = tree0 in
  let int0 = interim_th(cth0, tag0) in
  let lidB = leaf_id(gid, pkB) in
  (* The joiner stages its commit with the same transition rules as every
     verifier: its admission must come from an admin (section 9.4). *)
  if verify(pkA, CTX_ADMISSION, (gid, lidB), adm) = true then
  new rx: key;
  let ctx1 = kemct(extpk0, rx) in
  let init1 = external_init(kemss(extpk0, rx), ctx1) in
  new lsB1: key;
  let psB1 = path_secret(lsB1) in
  new r1: key;
  let wc1 = wrap_ctx(gid, N1, N1, N0, N1, leafA) in
  let ss1 = kemss(leafA, r1) in
  let th1 = hash(((lidA, leafA), (lidB, leaf_pk(lsB1)), node_pk(psB1))) in
  let rh1 = hash(((lidA, pkA), (lidB, pkB), pkA)) in
  let tbs1 = (gid, N1, K_join, int0, pkB, rh1, th1, leaf_pk(lsB1),
              kemct(leafA, r1), wrapk(wrap_key(ss1, wc1), wrap_nonce(ss1, wc1), wc1, psB1),
              ctx1, adm) in
  let sig1 = sign(skB, CTX_ANCHOR, tbs1) in
  let cth1 = confirmed_th(sig1) in
  let gc1 = (gid, N1, th1, rh1, cth1) in
  let es1 = epoch_secret(init1, commit_secret(psB1), gc1) in
  let tag1 = mac(confirm_key(es1), cth1) in
  event Committed(pkB, N1, gc1);
  event Accepted(pkB, N1, gc1, es1);
  out(c, (tbs1, sig1, tag1));
  out(leakB1, (leaf_sk(lsB1), node_sk(psB1), init_secret(es1),
               external_secret(es1), msg_secret(es1)));
  out(stB1, (gid, lidA, lidB, leafA, rh1, es1, interim_th(cth1, tag1))).

(* B re-keys from a fresh leaf secret (self-update, section 13.4); the new
   path secret goes to A's leaf. *)
let KS_B2 =
  let pkB = spk(skB) in
  in(stB1, (gid: bitstring, lidA: bitstring, lidB: bitstring, leafA: kpk,
            rh1: bitstring, es1: key, int1: bitstring));
  new lsB2: key;
  let psB2 = path_secret(lsB2) in
  new r2: key;
  let wc2 = wrap_ctx(gid, N2, N1, N0, N1, leafA) in
  let ss2 = kemss(leafA, r2) in
  let th2 = hash(((lidA, leafA), (lidB, leaf_pk(lsB2)), node_pk(psB2))) in
  let tbs2 = (gid, N2, K_member, int1, pkB, rh1, th2, leaf_pk(lsB2),
              kemct(leafA, r2), wrapk(wrap_key(ss2, wc2), wrap_nonce(ss2, wc2), wc2, psB2)) in
  let sig2 = sign(skB, CTX_ANCHOR, tbs2) in
  let cth2 = confirmed_th(sig2) in
  let gc2 = (gid, N2, th2, rh1, cth2) in
  let es2 = epoch_secret(init_secret(es1), commit_secret(psB2), gc2) in
  let tag2 = mac(confirm_key(es2), cth2) in
  event Committed(pkB, N2, gc2);
  event Accepted(pkB, N2, gc2, es2);
  out(c, (tbs2, sig2, tag2)).

let KS = KS_A0 | KS_A1 | KS_A2 | KS_B1 | KS_B2.

(* ============ Scenario RM: removal of a malicious member ============

   The group is at epoch 2 with A (slot 0, admin), B (slot 1) and C
   (slot 2), a malicious member: the adversary holds C's device key and all
   the secrets C holds as a member of epoch 2 (its leaf key, the keys of its
   direct path, the epoch secret) and the admission A once signed for C.
   Epoch 3: A removes C (section 9.4) and B processes the commit.
   Epoch 4: A processes an ExternalJoin: D, an honest device A admitted, or
   the adversary trying to bring C back.

   Tree of n_max = 4 slots, heap order: N0 root, N1 parent of slots 0 and 1,
   N2 parent of slots 2 and 3, N3 to N6 the leaves of slots 0 to 3.

   RM_B3(false) omits the rule that a commit cannot remove its author, and
   RM_A4(false) the rule that a retired device cannot join: the sanity
   scenarios check that the model finds the corresponding attacks. *)

free skC: skey.    (* the malicious member's device key: public *)
free stRA, stRB, stRA3: channel [private].

let RM_Setup =
  let pkA = spk(skA) in
  let pkB = spk(skB) in
  let pkC = spk(skC) in
  new nonce: bitstring;
  let gid = hash((pkA, nonce)) in
  let lidA = leaf_id(gid, pkA) in
  let lidB = leaf_id(gid, pkB) in
  let lidC = leaf_id(gid, pkC) in
  new lsA: key; new lsB: key; new lsC: key;
  (* Path secrets of epoch 2: node N1 (A and B), N2 (C), root (everyone). *)
  new p1: key; new p2: key; new p0: key;
  new es2: key;
  new int2: bitstring;
  let tree2 = ((lidA, leaf_pk(lsA)), (lidB, leaf_pk(lsB)), (lidC, leaf_pk(lsC)),
               NONE, node_pk(p1), node_pk(p2), node_pk(p0)) in
  let roster2 = ((lidA, pkA), (lidB, pkB), (lidC, pkC), NONE, pkA, NONE) in
  out(c, (gid, tree2, roster2, int2));
  (* What C holds as a member of epoch 2, and the admission it kept. *)
  event Admitted(pkA, gid, pkC);
  out(c, (leaf_sk(lsC), node_sk(p2), node_sk(p0), es2,
          sign(skA, CTX_ADMISSION, (gid, lidC))));
  out(stRA, (gid, lidB, lidC, lsA, leaf_pk(lsB), p1, es2, int2));
  out(stRB, (gid, lidA, lidC, lsB, leaf_pk(lsA), p1, es2, int2)).

(* A removes C with a proposal it signs as admin (section 10.1) and
   re-keys. The removal blanks C's leaf and direct path (N2 and the root)
   first, so A's path secret for N1 goes to B's leaf only, and the root
   secret to nobody: the resolution of N2 is empty (section 6.3). *)
let RM_A3 =
  let pkA = spk(skA) in
  let pkB = spk(skB) in
  in(stRA, (gid: bitstring, lidB: bitstring, lidC: bitstring, lsA: key,
            leafB: kpk, p1: key, es2: key, int2: bitstring));
  let lidA = leaf_id(gid, pkA) in
  let rp = sign(skA, CTX_REMOVE, (gid, lidC, N2, pkA)) in
  new lsA3: key;
  let q1 = path_secret(lsA3) in
  let q0 = path_secret(q1) in
  new r3: key;
  let wc3 = wrap_ctx(gid, N3, N0, N1, N4, leafB) in
  let ss3 = kemss(leafB, r3) in
  let tree3 = ((lidA, leaf_pk(lsA3)), (lidB, leafB), NONE, NONE,
               node_pk(q1), NONE, node_pk(q0)) in
  let roster3 = ((lidA, pkA), (lidB, pkB), NONE, NONE, pkA, lidC) in
  let th3 = hash(tree3) in
  let rh3 = hash(roster3) in
  let tbs3 = (gid, N3, K_member, int2, pkA, rh3, th3, rp, leaf_pk(lsA3),
              node_pk(q1), node_pk(q0), kemct(leafB, r3),
              wrapk(wrap_key(ss3, wc3), wrap_nonce(ss3, wc3), wc3, q1)) in
  let sig3 = sign(skA, CTX_ANCHOR, tbs3) in
  let cth3 = confirmed_th(sig3) in
  let gc3 = (gid, N3, th3, rh3, cth3) in
  let es3 = epoch_secret(init_secret(es2), commit_secret(q0), gc3) in
  let tag3 = mac(confirm_key(es3), cth3) in
  event Committed(pkA, N3, gc3);
  event Accepted(pkA, N3, gc3, es3);
  let gi3 = (gc3, tag3, kempk(external_sk(es3)), lidA) in
  out(c, (tbs3, sig3, tag3, gi3, sign(skA, CTX_GROUP_INFO, gi3), tree3, roster3));
  (* A admits a new device, D. *)
  event Admitted(pkA, gid, spk(skD));
  out(c, sign(skA, CTX_ADMISSION, (gid, leaf_id(gid, spk(skD)))));
  out(stRA3, (gid, lidA, lidB, lidC, lsA3, leafB, q1, es3, interim_th(cth3, tag3))).

(* B processes the commit of epoch 3 that removes C. With [checked], it
   applies the rule that the author of a commit is not one of its removal
   targets (section 9.4). *)
let RM_B3(checked: bool) =
  let pkA = spk(skA) in
  let pkB = spk(skB) in
  let pkC = spk(skC) in
  in(stRB, (gid: bitstring, lidA: bitstring, lidC: bitstring, lsB: key,
            leafA: kpk, p1: key, es2: key, int2: bitstring));
  let lidB = leaf_id(gid, pkB) in
  in(c, (tbs3: bitstring, sig3: bitstring, tag3: bitstring));
  let (=gid, =N3, =K_member, =int2, pkAu: spkey, rh3: bitstring, th3: bitstring,
       rp: bitstring, leafAu: kpk, pn: kpk, proot: kpk, ctw: bitstring,
       w: bitstring) = tbs3 in
  if verify(pkAu, CTX_ANCHOR, tbs3, sig3) = true then
  (* The removal of C (slot 2) is proposed by an admin (A) or by C itself. *)
  if verify(pkA, CTX_REMOVE, (gid, lidC, N2, pkA), rp) = true
     || verify(pkC, CTX_REMOVE, (gid, lidC, N2, pkC), rp) = true then
  let roster3 = ((lidA, pkA), (lidB, pkB), NONE, NONE, pkA, lidC) in
  if rh3 = hash(roster3) then
  if pkAu = pkA then
  (
    (* Author in slot 0: its N1 path secret is wrapped to B's leaf. *)
    let wc3 = wrap_ctx(gid, N3, N0, N1, N4, leaf_pk(lsB)) in
    let ss3 = decaps(leaf_sk(lsB), ctw) in
    let q1 = unwrapk(wrap_key(ss3, wc3), wrap_nonce(ss3, wc3), wc3, w) in
    let q0 = path_secret(q1) in
    if pn = node_pk(q1) && proot = node_pk(q0) then
    if th3 = hash(((lidA, leafAu), (lidB, leaf_pk(lsB)), NONE, NONE,
                   pn, NONE, proot)) then
    let cth3 = confirmed_th(sig3) in
    let gc3 = (gid, N3, th3, rh3, cth3) in
    let es3 = epoch_secret(init_secret(es2), commit_secret(q0), gc3) in
    if tag3 = mac(confirm_key(es3), cth3) then
    event Accepted(pkB, N3, gc3, es3)
  )
  else if checked = false && pkAu = pkC then
  (
    (* Without the rule, C authors its own removal from slot 2: its root
       path secret is wrapped to N1, whose key B holds. *)
    let wc3 = wrap_ctx(gid, N3, N2, N0, N1, node_pk(p1)) in
    let ss3 = decaps(node_sk(p1), ctw) in
    let q0 = unwrapk(wrap_key(ss3, wc3), wrap_nonce(ss3, wc3), wc3, w) in
    if proot = node_pk(q0) then
    if th3 = hash(((lidA, leafA), (lidB, leaf_pk(lsB)), NONE, NONE,
                   node_pk(p1), pn, proot)) then
    let cth3 = confirmed_th(sig3) in
    let gc3 = (gid, N3, th3, rh3, cth3) in
    let es3 = epoch_secret(init_secret(es2), commit_secret(q0), gc3) in
    if tag3 = mac(confirm_key(es3), cth3) then
    event Accepted(pkB, N3, gc3, es3)
  ).

(* A processes the ExternalJoin of some device X in epoch 4. X needs an
   admission from A and must not be a member. With [checked], a retired
   device cannot join (section 7). X enters the lowest free slot, slot 2:
   its N2 path secret goes to nobody (slot 3 is empty) and its root secret
   to N1, whose key A holds. *)
let RM_A4(checked: bool) =
  let pkA = spk(skA) in
  let pkB = spk(skB) in
  in(stRA3, (gid: bitstring, lidA: bitstring, lidB: bitstring, lidC: bitstring,
             lsA3: key, leafB: kpk, q1: key, es3: key, int3: bitstring));
  in(c, (tbs4: bitstring, sig4: bitstring, tag4: bitstring));
  let (=gid, =N4, =K_join, =int3, pkX: spkey, rh4: bitstring, th4: bitstring,
       leafX: kpk, pn2: kpk, proot: kpk, ctw4: bitstring, w4: bitstring,
       ctx4: bitstring, adm4: bitstring) = tbs4 in
  if verify(pkX, CTX_ANCHOR, tbs4, sig4) = true then
  let lidX = leaf_id(gid, pkX) in
  if verify(pkA, CTX_ADMISSION, (gid, lidX), adm4) = true then
  if lidX <> lidA && lidX <> lidB then
  if checked = true && lidX = lidC then 0 else
  let wc4 = wrap_ctx(gid, N4, N2, N0, N1, node_pk(q1)) in
  let ss4 = decaps(node_sk(q1), ctw4) in
  let ps0 = unwrapk(wrap_key(ss4, wc4), wrap_nonce(ss4, wc4), wc4, w4) in
  if proot = node_pk(ps0) then
  if th4 = hash(((lidA, leaf_pk(lsA3)), (lidB, leafB), (lidX, leafX), NONE,
                 node_pk(q1), pn2, proot)) then
  if rh4 = hash(((lidA, pkA), (lidB, pkB), (lidX, pkX), NONE, pkA, lidC)) then
  let ssx = decaps(external_sk(es3), ctx4) in
  let cth4 = confirmed_th(sig4) in
  let gc4 = (gid, N4, th4, rh4, cth4) in
  let es4 = epoch_secret(external_init(ssx, ctx4), commit_secret(ps0), gc4) in
  if tag4 = mac(confirm_key(es4), cth4) then
  event AcceptedJoin(pkA, N4, pkX);
  event Accepted(pkA, N4, gc4, es4).

(* D, an honest device, joins in epoch 4 from A's GroupInfo of epoch 3. *)
let RM_D4 =
  let pkA = spk(skA) in
  let pkB = spk(skB) in
  let pkD = spk(skD) in
  in(c, (gi3: bitstring, gisig3: bitstring, tree3: bitstring, roster3: bitstring,
         adm: bitstring));
  if verify(pkA, CTX_GROUP_INFO, gi3, gisig3) = true then
  let ((gid: bitstring, =N3, th3: bitstring, rh3: bitstring, cth3: bitstring),
       tag3: bitstring, extpk3: kpk, lidA: bitstring) = gi3 in
  if lidA = leaf_id(gid, pkA) then
  if th3 = hash(tree3) then
  if rh3 = hash(roster3) then
  let ((=lidA, leafA: kpk), (lidB: bitstring, leafB: kpk), =NONE, =NONE,
       n1: kpk, =NONE, n0: kpk) = tree3 in
  let ((=lidA, =pkA), (=lidB, =pkB), =NONE, =NONE, =pkA, lidC: bitstring) = roster3 in
  let lidD = leaf_id(gid, pkD) in
  if verify(pkA, CTX_ADMISSION, (gid, lidD), adm) = true then
  new rx: key;
  let ctx4 = kemct(extpk3, rx) in
  let init4 = external_init(kemss(extpk3, rx), ctx4) in
  new lsD: key;
  let d2 = path_secret(lsD) in
  let d0 = path_secret(d2) in
  new r4: key;
  let wc4 = wrap_ctx(gid, N4, N2, N0, N1, n1) in
  let ss4 = kemss(n1, r4) in
  let th4 = hash(((lidA, leafA), (lidB, leafB), (lidD, leaf_pk(lsD)), NONE,
                  n1, node_pk(d2), node_pk(d0))) in
  let rh4 = hash(((lidA, pkA), (lidB, pkB), (lidD, pkD), NONE, pkA, lidC)) in
  let tbs4 = (gid, N4, K_join, interim_th(cth3, tag3), pkD, rh4, th4,
              leaf_pk(lsD), node_pk(d2), node_pk(d0), kemct(n1, r4),
              wrapk(wrap_key(ss4, wc4), wrap_nonce(ss4, wc4), wc4, d0), ctx4, adm) in
  let sig4 = sign(skD, CTX_ANCHOR, tbs4) in
  let cth4 = confirmed_th(sig4) in
  let gc4 = (gid, N4, th4, rh4, cth4) in
  let es4 = epoch_secret(init4, commit_secret(d0), gc4) in
  let tag4 = mac(confirm_key(es4), cth4) in
  event Committed(pkD, N4, gc4);
  event Accepted(pkD, N4, gc4, es4);
  out(c, (tbs4, sig4, tag4)).

(* ============ Scenario MS: messages (section 11) ============ *)

let SendMsg(sk: skey, gid: bitstring, n: bitstring, es: key, lid: bitstring) =
  new m: bitstring;
  event Sent(spk(sk), n, m);
  let fc = (gid, n, lid, m) in
  let hdr = (hash((gid, n)), lid) in
  out(c, (hdr, aenc(msg_key(es, lid), msg_nonce(es, lid), hdr,
                    (fc, sign(sk, CTX_MSG, fc))))).

(* A receiver takes the sender's key from the roster (here [from], the
   member of leaf [lid]), derives the key of its chain, checks that the
   framed content matches the envelope, and verifies the signature under
   CTX_MSG before releasing the plaintext (section 11.3). *)
let RecvMsg(me: spkey, from: spkey, gid: bitstring, n: bitstring, es: key,
            lid: bitstring) =
  in(c, (hdr: bitstring, ct: bitstring));
  if hdr = (hash((gid, n)), lid) then
  let (fc: bitstring, fsig: bitstring) =
    adec(msg_key(es, lid), msg_nonce(es, lid), hdr, ct) in
  let (=gid, =n, =lid, m: bitstring) = fc in
  if verify(from, CTX_MSG, fc, fsig) = true then
  event Received(me, from, n, m).

(* Group 1 (epoch N1): A, B and C, a malicious member that knows the epoch
   secret. Group 2 (epoch N2): A and B only. A also signs anything the
   adversary asks under another context, as it does for its commits. *)
let MS =
  let pkA = spk(skA) in
  let pkB = spk(skB) in
  new gid1: bitstring;
  new es1: key;
  out(c, (gid1, es1));
  new gid2: bitstring;
  new es2: key;
  out(c, gid2);
  (SendMsg(skA, gid1, N1, es1, leaf_id(gid1, pkA))
   | RecvMsg(pkB, pkA, gid1, N1, es1, leaf_id(gid1, pkA))
   | SendMsg(skA, gid2, N2, es2, leaf_id(gid2, pkA))
   | RecvMsg(pkB, pkA, gid2, N2, es2, leaf_id(gid2, pkA))
   | (!in(c, x: bitstring); out(c, sign(skA, CTX_ANCHOR, x)))).
