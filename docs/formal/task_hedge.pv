(* Scenario TASK_HEDGE (profile v0.5-draft, stage 2): a performer whose
   generator is weak.

   Window 2 removes M, which holds the init secret of epoch 1 and every
   secret it knew; the attacker has them. P performs the task that holds
   the root while its generator is weak: the attacker reads every value it
   gives. P hedges them with its leaf seed, which only P holds
   (docs/specs-v0.5-draft.md, section 3.3): the root secret r2, and the
   coins of the encapsulation that wraps r2 to A's leaf. A message is sent
   in epoch 2.

   Expected: proved: M does not read epoch 2.
   Reachable (sanity): A accepts epoch 2. *)

free MA: bitstring [private].
query attacker(MA).

event AAccepts(key).
query es: key; event(AAccepts(es)).

process
  new lsA: key; new lsP: key; new es1: key;
  let init1 = init_secret(es1) in
  (* M's state of epoch 1, and the public keys. *)
  out(c, (es1, leaf_pk(lsA), leaf_pk(lsP)));
  (* Window 2: every value P's generator gives, the attacker reads. *)
  new g1: key; new g2: key;
  out(c, (g1, g2));
  let h = task_hedge(lsP, N2) in
  let r2 = fresh(h, g1) in
  let gc2 = (N2, node_pk(r2)) in
  let es2 = epoch_secret(joiner_secret(init1, r2, gc2)) in
  out(c, (wrap(leaf_pk(lsA), coins(h, g2), r2), gc2, tag(es2, gc2)));
  out(c, aenc(msg_key(es2), MA));
  (
    (* A follows window 2. *)
    in(c, (wa: bitstring, g: bitstring, tg: bitstring));
    let r = unwrap(leaf_sk(lsA), wa) in
    let es = epoch_secret(joiner_secret(init1, r, g)) in
    if tag(es, g) = tg then
    event AAccepts(es)
  )
