(* Key schedule and ratchet tree against an active network (the delivery
   service, adversaries A1 and A2 of section 2.1): a genesis, an external
   join and a self-update.
   Run: proverif -lib cityg.pvl key_schedule.pv *)

(* Confidentiality of every accepted epoch secret. *)
query pk: spkey, n: bitstring, gc: bitstring, es: key;
  event(Accepted(pk, n, gc, es)) && attacker(es) ==> false.

(* Membership agreement: every accepted epoch context (tree hash, registry
   hash, transcript) was committed by an honest member, and two members
   that accept epoch n agree on its context and secret. *)
query pk: spkey, n: bitstring, gc: bitstring, es: key;
  event(Accepted(pk, n, gc, es)) ==>
    event(Committed(spk(skA), n, gc)) || event(Committed(spk(skB), n, gc)).
query n: bitstring, gc: bitstring, gc2: bitstring, es: key, es2: key;
  event(Accepted(spk(skA), n, gc, es)) && event(Accepted(spk(skB), n, gc2, es2))
    ==> gc = gc2 && es = es2.

(* Admission control: an entry is accepted only with an admin's admission. *)
query n: bitstring, x: spkey, g: bitstring;
  event(AcceptedJoin(spk(skA), n, x)) ==> event(Admitted(spk(skA), g, x)).

process
  out(c, (spk(skA), spk(skB)));
  KS
