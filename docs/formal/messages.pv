(* Message plane v3 (section 11): sender authentication against a member of
   the group, and confidentiality against non-members.
   Run: proverif -lib cityg.pvl messages.pv *)

(* A member that knows the epoch secret cannot speak for another member,
   even with signatures of that member under other contexts. *)
query a: spkey, b: spkey, n: bitstring, m: bitstring;
  event(Received(b, a, n, m)) ==> event(Sent(a, n, m)).

(* Messages of a group whose epoch secret the adversary lacks stay
   confidential. *)
query pk: spkey, m: bitstring;
  event(Sent(pk, N2, m)) && attacker(m) ==> false.

(* Expected to be false: inside group 1, the malicious member reads. *)
query pk: spkey, m: bitstring;
  event(Sent(pk, N1, m)) && attacker(m) ==> false.

process
  out(c, (spk(skA), spk(skB)));
  MS
