(* Device-key rotation (sections 9.2, 9.3, 11.3): B replaces its device key,
   then the old key leaks. The old key can no longer author a commit or a
   message of B's occupancy, and the epoch secrets stay secret.
   Run: proverif -lib cityg.pvl rotation.pv *)

(* A accepts a commit of B's occupancy after the rotation only if B wrote it
   with its new key. *)
query k: spkey, gc: bitstring;
  event(AcceptedCommit(spk(skA), N3, k, gc)) ==> event(Committed(k, N3, gc)).

(* A accepts a message of B's occupancy in the epoch of the rotation only if
   B sent it with the key it held in that epoch. *)
query k: spkey, m: bitstring;
  event(Received(spk(skA), k, N2, m)) ==> event(Sent(k, N2, m)).

(* The leak of the old key exposes no epoch secret. *)
query pk: spkey, n: bitstring, gc: bitstring, es: key;
  event(Accepted(pk, n, gc, es)) && attacker(es) ==> false.

(* Reachability, expected to be false: A accepts B's next commit and its
   message. *)
query gc: bitstring; event(AcceptedCommit(spk(skA), N3, spk(skB2), gc)) ==> false.
query m: bitstring; event(Received(spk(skA), spk(skB2), N2, m)) ==> false.

process
  out(c, (spk(skA), spk(skB), spk(skB2)));
  (RT_Setup | RT_B | RT_A2 | RT_A3 | RT_Leak)
