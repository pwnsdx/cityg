(* Batched joins (sections 9.4, 10.3): two devices A admitted enter with one
   commit, each with its welcome; B processes the commit.
   Run: proverif -lib cityg.pvl joins.pv *)

(* Confidentiality of every accepted epoch secret, including the joiner
   secret that the welcomes carry, and of the epoch before the joins. *)
query pk: spkey, n: bitstring, gc: bitstring, es: key;
  event(Accepted(pk, n, gc, es)) && attacker(es) ==> false.
query es: key; event(PreviousEpoch(es)) && attacker(es) ==> false.

(* Membership agreement, joiners included: the context every member accepts
   for epoch 2 (tree hash, registry hash, transcript) was committed by A,
   and every member that accepts A's context derives A's epoch secret.
   (ProVerif's abstraction does not know that A commits once, so it cannot
   prove directly that two members accept the same context.) *)
query pk: spkey, gc: bitstring, es: key;
  event(Accepted(pk, N2, gc, es)) ==> event(Committed(spk(skA), N2, gc)).
query pk: spkey, gc: bitstring, es: key, es2: key;
  event(Accepted(pk, N2, gc, es)) && event(Accepted(spk(skA), N2, gc, es2)) ==> es = es2.

(* Admission control: B accepts an entry only with an admin's admission. *)
query n: bitstring, x: spkey, g: bitstring;
  event(AcceptedJoin(spk(skB), n, x)) ==> event(Admitted(spk(skA), g, x)).

(* Reachability, expected to be false: both joiners enter. *)
query gc: bitstring, es: key; event(Accepted(spk(skJ1), N2, gc, es)) ==> false.
query gc: bitstring, es: key; event(Accepted(spk(skJ2), N2, gc, es)) ==> false.

process
  out(c, (spk(skA), spk(skB), spk(skJ1), spk(skJ2)));
  (JN_Setup | JN_A2 | JN_B2 | JN_J(skJ1, true, false) | JN_J(skJ2, true, false))
