(* Sanity check: without the rule that a commit cannot remove its author
   (section 9.4, audit C-03), the removed member authors its own removal
   and learns the secret of the next epoch. Expected result: false.
   Run: proverif -lib cityg.pvl removal_without_author_rule.pv *)

query pk: spkey, gc: bitstring, es: key;
  event(Accepted(pk, N3, gc, es)) && attacker(es) ==> false.

process
  out(c, (spk(skA), spk(skB), spk(skD)));
  (RM_Setup | RM_A3 | RM_B3(false))
