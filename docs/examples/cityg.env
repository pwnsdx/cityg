# Environment of the City-G v0.3 delivery service (cityg-api).
# Copy to docs/examples/cityg.env (Docker Compose) or /etc/cityg/cityg.env
# (systemd). Every CITYG_<SECTION>_<KEY> variable overrides the matching key
# of the configuration file; see docs/configuration.md.

LOG_FORMAT=json
RUST_LOG=info

# Bind address.
CITYG_SERVER_ADDRESS=0.0.0.0:8080
# Room journals and snapshots. Without it, rooms live in memory only.
CITYG_SERVER_STATE_PATH=/var/lib/cityg/rooms
# Capacity of the log-head notification channel.
CITYG_SERVER_WEBSOCKET_CAPACITY=2000
# Largest capacity a new group may declare (at most 8192).
CITYG_SERVER_MAX_GROUP_SIZE=256
# Retention of messages (7 days) and commits (30 days) in room logs.
CITYG_SERVER_MESSAGE_RETENTION_SECS=604800
CITYG_SERVER_COMMIT_RETENTION_SECS=2592000
CITYG_SERVER_MAX_LOG_ENTRIES=50000
# Member session tokens (1 hour) and accepted SessionAuth clock skew.
CITYG_SERVER_SESSION_TTL_SECS=3600
CITYG_SERVER_AUTH_SKEW_SECS=300
# Journal length that triggers a room snapshot.
CITYG_SERVER_COMPACT_EVERY=256

# Server URL proposed by the GUI and used by the join_leave CLI.
CITYG_CLIENT_DEFAULT_SERVER_URL=https://cityg.example.com
