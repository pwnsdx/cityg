# Copy to docs/examples/cityg.env (compose) or /etc/cityg/cityg.env (systemd)

LOG_FORMAT=json
RUST_LOG=info

# Server
CITYG_SERVER_ADDRESS=0.0.0.0:8080
CITYG_SERVER_WEBSOCKET_CAPACITY=2000
CITYG_SERVER_WINDOW_TTL_SECS=120

# Protocol capacity limits
CITYG_PROTOCOL_WINDOW_DURATION_SECS=120
CITYG_PROTOCOL_MAX_CONCURRENT_HEADS=32
CITYG_PROTOCOL_EPOCH_ROTATION_INTERVAL_SECS=300
CITYG_PROTOCOL_DEFAULT_SRX_MAX_BYTES=2097152
CITYG_PROTOCOL_MAX_HP_PROOF_BYTES=524288
CITYG_PROTOCOL_MAX_VRF_PROOF_BYTES=6144
CITYG_PROTOCOL_FS_CAPSS_MAX_BYTES=16384
CITYG_PROTOCOL_SRX_SMALLWOOD_MAX_BYTES=16384
CITYG_PROTOCOL_MAX_HP_ENVELOPE_BYTES=16384
CITYG_PROTOCOL_MIN_SRX_MAX_BYTES=262144
CITYG_PROTOCOL_RECEIVER_CACHE_TTL_SECS=10

# FS policy
CITYG_PROTOCOL_FS_POLICY_VERSION=fs-demo-policy
CITYG_PROTOCOL_FS_POLICY_H_SECONDS=300
CITYG_PROTOCOL_FS_POLICY_CHECKPOINT_INTERVAL_SECS=3600
CITYG_PROTOCOL_FS_POLICY_CHECKPOINT_HEAD_THRESHOLD=24
CITYG_PROTOCOL_FS_POLICY_SLACK_ANCHOR=0
CITYG_PROTOCOL_FS_POLICY_SLACK_FIRST_DEVICE=0
CITYG_PROTOCOL_FS_POLICY_SLACK_DEVICE=4

# Client defaults for tooling/CLI
CITYG_CLIENT_DEFAULT_SERVER_URL=http://localhost:8080
CITYG_CLIENT_API_TIMEOUT_SECS=60
