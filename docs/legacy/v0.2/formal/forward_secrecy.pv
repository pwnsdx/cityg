(* Forward secrecy (section 2.2): the whole state A holds after epoch 2
   leaks: its leaf and root private keys, init_secret_2, external_secret_2
   and msg_secret_2. The adversary may use it at any point of the run, which
   is stronger than a compromise after epoch 2 (and faster to analyse than
   a separate phase). The secrets of epochs 0 to 2 stay secret; what A keeps
   for the next epoch leaks.
   Run: proverif -lib cityg.pvl forward_secrecy.pv *)

(* Epoch secrets accepted before the compromise stay secret. *)
query pk: spkey, n: bitstring, gc: bitstring, es: key;
  event(Accepted(pk, n, gc, es)) && attacker(es) ==> false.

(* Sanity check, expected to be false: the leak is real, the secrets that
   A keeps for epoch 3 are exposed. *)
query gc: bitstring, es: key;
  event(Accepted(spk(skA), N2, gc, es)) && attacker(expand_label(es, L_init, NONE)) ==> false.

process
  out(c, (spk(skA), spk(skB)));
  (KS | (in(leakA2, state: bitstring); out(c, state)))
