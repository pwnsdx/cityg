(* Post-compromise security (section 2.2, adversary A5): B's state leaks
   after epoch 1: its leaf and root private keys, init_secret_1,
   external_secret_1 and msg_secret_1. B's device key stays secret. B then
   re-keys from a fresh leaf secret (epoch 2): the secret of epoch 2 is out
   of the adversary's reach again.
   Run: proverif -lib cityg.pvl post_compromise.pv *)

(* Healing: the epoch that follows B's self-update is secret. *)
query pk: spkey, gc: bitstring, es: key;
  event(Accepted(pk, N2, gc, es)) && attacker(es) ==> false.

(* Sanity check, expected to be false: epoch 1 is exposed by the leak. *)
query pk: spkey, gc: bitstring, es: key;
  event(Accepted(pk, N1, gc, es)) && attacker(expand_label(es, L_init, NONE)) ==> false.

process
  out(c, (spk(skA), spk(skB)));
  (KS | (in(leakB1, state: bitstring); out(c, state)))
