(* Extract(salt, ikm) as a dual PRF: a PRF keyed by its salt, and a PRF
   keyed by its input keying material. The HKDF analyses of MLS and TLS 1.3
   assume the same of HMAC. *)

def dual_PRF(key, output, f, Psalt, Pikm) {

fun f(key, key): output.

param Nk, N.

equiv(prf_salt(f))
  foreach ik <= Nk do k <-R key; (
    foreach i <= N do O(x: key) := return(f(k, x)))
<=(Psalt(time, Nk, #O))=>
  foreach ik <= Nk do foreach i <= N do O(x: key) :=
    find[unique] u <= N suchthat defined(x[u], r[u]) && x = x[u] then return(r[u])
    else r <-R output; return(r).

equiv(prf_ikm(f))
  foreach ik <= Nk do k <-R key; (
    foreach i <= N do O(x: key) := return(f(x, k)))
<=(Pikm(time, Nk, #O))=>
  foreach ik <= Nk do foreach i <= N do O(x: key) :=
    find[unique] u <= N suchthat defined(x[u], r[u]) && x = x[u] then return(r[u])
    else r <-R output; return(r).

}
