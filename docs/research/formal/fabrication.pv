(* Scenario FAB: the delivery service fabricates the next epoch for a member
   that checks the confirmation tag and not the committer's signature, with
   the init chain.

   A and B share epoch 1 (A holds init1). B, the committer of window 2,
   sends an honest commit. A accepts any commit whose wrap it can open and
   whose tag checks under the epoch secret it derives; it does not verify
   signatures. The attacker (the delivery service) knows every public key
   and can wrap a root of its choice to A's leaf. *)

free MA: bitstring [private].
query attacker(MA).

event AcceptedA(key).
query es: key; event(AcceptedA(es)).

process
  new lsA: key; new lsB: key; new init1: key; new skB: skey;
  out(c, (leaf_pk(lsA), leaf_pk(lsB), spk(skB)));
  (
    new r2: key; new qa: key; new qb: key;
    let gc2 = (N2, node_pk(r2)) in
    let es2 = epoch_secret(joiner_secret(init1, r2, gc2)) in
    out(c, (wrap(leaf_pk(lsA), qa, r2), wrap(leaf_pk(lsB), qb, r2), gc2, tag(es2, gc2),
            sign(skB, (N2, gc2, tag(es2, gc2)))))
  ) | (
    in(c, (w: bitstring, gc2: bitstring, tg: bitstring));
    let (=N2, pkr: kpk) = gc2 in
    let r2 = unwrap(leaf_sk(lsA), w) in
    if node_pk(r2) = pkr then
    let es2 = epoch_secret(joiner_secret(init1, r2, gc2)) in
    if tag(es2, gc2) = tg then
    event AcceptedA(es2);
    out(c, aenc(msg_key(es2), MA))
  )
