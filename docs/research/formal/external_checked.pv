(* Scenario EXTERNAL-CHECKED: the same forgery, for a member that also
   checks the entrant's admission and its signature of the seal (decision
   E-7 of the design note).

   The delivery service controls a device E that no admin admitted. The
   admin admitted J, which seals window 2 honestly. A accepts a window
   sealed by an entrant only if an admin admitted the entrant's key and
   that key signed the seal, tag included. *)

free skAdmin: skey [private].

free MA: bitstring [private].
query attacker(MA).

event AcceptedA(key).
query es: key; event(AcceptedA(es)).

process
  new lsA: key; new lsB: key; new es1: key; new skE: skey; new skJ: skey;
  out(c, (leaf_pk(lsA), leaf_pk(lsB), external_pk(es1), spk(skAdmin), skE));
  out(c, (spk(skJ), sign(skAdmin, (ADMIT, spk(skJ)))));
  (
    new r2: key; new init_ext: key; new qa: key; new qb: key; new qx: key;
    let ct = wrap(external_pk(es1), qx, init_ext) in
    let gc2 = (N2, node_pk(r2), ct) in
    let es2 = epoch_secret(joiner_secret(init_ext, r2, gc2)) in
    out(c, (wrap(leaf_pk(lsA), qa, r2), wrap(leaf_pk(lsB), qb, r2), gc2, tag(es2, gc2),
            sign(skJ, (N2, gc2, tag(es2, gc2)))))
  ) | (
    in(c, (pkJ: spkey, adm: bitstring));
    if checksign(spk(skAdmin), (ADMIT, pkJ), adm) = true then
    in(c, (w: bitstring, gc2: bitstring, tg: bitstring, sg: bitstring));
    if checksign(pkJ, (N2, gc2, tg), sg) = true then
    let (=N2, pkr: kpk, ct: bitstring) = gc2 in
    let r2 = unwrap(leaf_sk(lsA), w) in
    if node_pk(r2) = pkr then
    let init_ext = unwrap(external_sk(es1), ct) in
    let es2 = epoch_secret(joiner_secret(init_ext, r2, gc2)) in
    if tag(es2, gc2) = tg then
    event AcceptedA(es2);
    out(c, aenc(msg_key(es2), MA))
  )
