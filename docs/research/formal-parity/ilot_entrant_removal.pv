(* Scenario ILOT_ENTRANT_REMOVAL: nobody is online, a removal waits, and the
   joiner who enters alone applies it and renews the top.

   Îlot k holds M and B; îlot j holds A and receives J. M was removed while
   every member was offline, and knows the secrets of epoch 1, hence the
   external key, and the root of îlot k; it works with the server. J,
   admitted by an admin, seals window 2 alone: X sealed to the external key
   of epoch 1; a fresh root for îlot k, wrapped to B's leaf; a fresh window
   secret sealed to both îlot roots, the new one of k and the root of j;
   epoch 2 from X and the window secret. J sends MJ in epoch 2.

   Expected: proved. M opens X but not the window secret, which goes to
   îlot roots M does not know. *)

free skAdm: skey [private].

free MJ: bitstring [private].
query attacker(MJ).

process
  new es1: key; new sk: key; new sj: key; new lsB: key; new skJ: skey;
  new x: key; new sk2: key; new r2: key; new q1: key; new q2: key; new q3: key; new q4: key;
  (* What M gives the server; the public keys. *)
  out(c, (es1, sk, leaf_pk(lsB), node_pk(sj), spk(skAdm), spk(skJ)));
  let admission = sign(skAdm, (L_join, spk(skJ))) in
  let xi = seal(external_pk(es1), q1, N2, x) in
  (* The re-key of îlot k and the top. *)
  out(c, seal(leaf_pk(lsB), q2, N2, sk2));
  out(c, (seal(node_pk(sk2), q3, N2, r2), seal(node_pk(sj), q4, N2, r2)));
  let g2 = (N2, xi, spk(skJ), node_pk(sk2), node_pk(sj)) in
  let es2 = epoch_secret(joiner_secret(x, commit_secret(r2), g2)) in
  let tg = tag(es2, g2) in
  out(c, (spk(skJ), admission, xi, g2, tg, sign(skJ, (L_seal, g2, tg))));
  out(c, aenc(msg_key(es2), MJ))
