(* Scenario BURST_CHAIN: one signature of the sender's card covers a burst
   of envelopes.

   S signs with its sender card. The attacker is a member of the epoch: it
   knows the message key, so it can read every envelope and build any
   envelope that decrypts. S sends bursts of two envelopes: the first goes
   unsigned; the second comes with S's card signature over the epoch and
   the chain value of both. A reader accepts an envelope as S's only once
   it holds a signature of S over a chain that contains it: before that,
   the envelope is authenticated by the group key only, as from any
   member. *)

free skS: skey [private].
free gk: key.

event Sent(bitstring).
event AcceptedFromS(bitstring).
query m: bitstring; event(AcceptedFromS(m)) ==> event(Sent(m)).

process
  out(c, spk(skS));
  (
    (* Sender S: bursts of two envelopes, one signature. *)
    !
    new m1: bitstring; new m2: bitstring;
    event Sent(m1);
    let e1 = aenc(gk, m1) in
    out(c, e1);
    event Sent(m2);
    let e2 = aenc(gk, m2) in
    let c2 = chain(chain(ZERO, e1), e2) in
    out(c, (e2, sign(skS, (L_card, N1, c2))))
  ) | (
    (* A reader: the envelopes of a burst, then the signature. *)
    !
    in(c, x1: bitstring);
    in(c, (x2: bitstring, s: bitstring));
    if checksign(spk(skS), (L_card, N1, chain(chain(ZERO, x1), x2)), s) = true then
    event AcceptedFromS(adec(gk, x1));
    event AcceptedFromS(adec(gk, x2))
  )
