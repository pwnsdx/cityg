(* Scenario READER_REMOVED_SIGNED_BUNDLE: the removal of reader_removed.pv,
   where Q also requires the keeper to sign its bundle.

   Q knows K's device key from its anchor: in the protocol, a leaf proof of
   K in the keepers' tree of the epoch Q last accepted. K signs the request
   it answers, the bundle and the seal hash it answers with. The removed
   reader R, a reader and not a keeper, cannot sign as K. *)

free skR: skey.
free skQ, skK: skey [private].

free MK: bitstring [private].
query attacker(MK).

free MQ: bitstring [private].
query attacker(MQ).

process
  new es1: key; new r: key; new interim1: bitstring;
  let rs1 = reader_secret(es1) in
  out(c, (rs1, interim1, spk(skQ), spk(skK)));
  let gc2 = (N2, node_pk(r)) in
  let es2 = epoch_secret(joiner_secret(init_secret(es1), r, gc2)) in
  let rs2 = reader_secret(es2) in
  new seal_hash2: bitstring;
  let cth2 = hash((interim1, seal_hash2)) in
  out(c, (gc2, seal_hash2, reader_tag(rs1, cth2, rs2)));
  (
    out(c, aenc(msg_key(rs2), MK))
  ) | (
    !
    in(c, (req: bitstring, sg: bitstring));
    if checksign(spk(skQ), req, sg) = true then
    let (=L_request, =N2, otpk: kpk) = req in
    new rk: key;
    let b = seal(otpk, rk, hash(req), rs2) in
    out(c, (b, seal_hash2, sign(skK, (L_bundle, hash(req), b, seal_hash2))))
  ) | (
    new otk: key;
    let req = (L_request, N2, kempk(otk)) in
    out(c, (req, sign(skQ, req)));
    in(c, (b: bitstring, sh: bitstring, sk_sig: bitstring, rt: bitstring));
    if checksign(spk(skK), (L_bundle, hash(req), b, sh), sk_sig) = true then
    let rs = open(otk, hash(req), b) in
    if rt = reader_tag(rs1, hash((interim1, sh)), rs) then
    out(c, aenc(msg_key(rs), MQ))
  )
