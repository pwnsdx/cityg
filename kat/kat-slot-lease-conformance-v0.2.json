{
  "profile_version": "v0.2",
  "kind": "slot-lease-conformance-manifest",
  "notes": [
    "This manifest links the reusable-slot lease invariants to deterministic implementation tests.",
    "Coverage spans server acceptance, authenticated helper outputs, public join/merge ticket verification, and live API reclaim telemetry."
  ],
  "requirements": [
    {
      "id": "SL1",
      "title": "Reclaim join-finalize clears superseded revoked occupancy",
      "coverage": [
        {
          "crate": "cityg-server",
          "test": "tests::slot_reuse_join_finalize_reclaim_clears_committed_revocation",
          "expectation": "accept_reclaim_clears_revoked_slot"
        }
      ]
    },
    {
      "id": "SL2",
      "title": "Stale join_finalize_auth cannot authorize a later occupancy of the same slot",
      "coverage": [
        {
          "crate": "cityg-server",
          "test": "tests::slot_reuse_rejects_stale_join_finalize_auth_token",
          "expectation": "reject_stale_join_finalize_auth"
        },
        {
          "crate": "cityg-api",
          "test": "public_stale_join_finalize_auth_rejected_after_slot_reuse",
          "expectation": "reject_stale_join_finalize_auth_over_api"
        }
      ]
    },
    {
      "id": "SL3",
      "title": "Authenticated helper views preserve slot generations across slot reuse",
      "coverage": [
        {
          "crate": "cityg-server",
          "test": "barrier_snapshot_helpers::resolve_join_occupancies_since_keeps_latest_generation_for_reused_slot",
          "expectation": "accept_latest_generation_only"
        },
        {
          "crate": "cityg-api-client",
          "test": "tests::barrier_resolve_revoked_occupancies_preserves_multiple_generations_for_one_slot",
          "expectation": "accept_multiple_generations_per_slot"
        },
        {
          "crate": "cityg-api",
          "test": "public_barrier_helpers_preserve_slot_generations_across_slot_reuse",
          "expectation": "accept_public_helper_slot_reuse_end_to_end"
        },
        {
          "crate": "cityg-api-client",
          "test": "helper_completeness_attestation_binds_slot_generation",
          "expectation": "reject_generation_tamper"
        }
      ]
    },
    {
      "id": "SL4",
      "title": "Public join/merge provisioning artifacts bind versioned occupancies",
      "coverage": [
        {
          "crate": "cityg-api-client",
          "test": "tests::prepare_runtime_join_ticket_rejects_tampered_join_occupancy_slot_generation",
          "expectation": "reject_join_occupancy_generation_tamper"
        },
        {
          "crate": "cityg-api-client",
          "test": "tests::prepare_runtime_join_ticket_rejects_tampered_revoked_occupancy_slot_generation",
          "expectation": "reject_revoked_occupancy_generation_tamper"
        },
        {
          "crate": "cityg-api-client",
          "test": "tests::merge_ticket_rejects_tampered_slot_generation",
          "expectation": "reject_merge_ticket_generation_tamper"
        }
      ]
    },
    {
      "id": "SL5",
      "title": "Public acceptance lookup tracks reclaim join-finalize lifecycle",
      "coverage": [
        {
          "crate": "cityg-api",
          "test": "public_lookup_merge_acceptance_tracks_reclaim_join_finalize",
          "expectation": "pending_then_accepted_reclaim_lookup"
        }
      ]
    },
    {
      "id": "SL6",
      "title": "Public telemetry reflects concurrent slot capacity after reclaim",
      "coverage": [
        {
          "crate": "cityg-api",
          "test": "public_telemetry_tracks_slot_capacity_after_reclaim_join_finalize",
          "expectation": "active_reserved_counts_match_reclaimed_slot_state"
        }
      ]
    }
  ]
}
